<%- include('../partials/header') %>
    <div class="staff-shell">
        <%- include('../partials/staff-sidebar', { activePage: 'vet-dashboard' }) %>
            <main class="staff-main">
                <div class="container-fluid p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h1 class="h3 fw-bold mb-1 text-dark">Appointment Record</h1>
                            <p class="text-muted mb-0">Detailed view for <%= appointment.pet_name %>
                            </p>
                        </div>
                        <a href="<%= currentUser.role === 'staff' ? '/staff/vet-dashboard' : '/appointments/my' %>"
                            class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                        </a>
                    </div>

                    <div class="row g-4">

                        <!-- Vitals Card -->
                        <div class="col-lg-6">
                            <div class="card bg-white border-0 shadow-sm rounded-3 h-100">
                                <div class="card-body p-4">
                                    <h5 class="fw-bold mb-3"><i class="bi bi-heart-pulse text-danger me-2"></i> Clinical
                                        Vitals</h5>

                                    <div class="row g-3">
                                        <div class="col-sm-6">
                                            <div class="p-3 bg-light rounded-3 h-100">
                                                <div class="text-muted small fw-bold text-uppercase mb-1">Weight</div>
                                                <div class="fs-4 fw-semibold text-dark">
                                                    <%= appointment.vitals_weight || '—' %> kg
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-6">
                                            <div class="p-3 bg-light rounded-3 h-100">
                                                <div class="text-muted small fw-bold text-uppercase mb-1">Temperature
                                                </div>
                                                <div class="fs-4 fw-semibold text-dark">
                                                    <%= appointment.vitals_temperature || '—' %> °C
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="p-3 bg-light rounded-3">
                                                <div class="text-muted small fw-bold text-uppercase mb-1">Observations
                                                </div>
                                                <div class="text-dark">
                                                    <%= appointment.vitals_observations || 'No observations recorded.'
                                                        %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- Appointment Info Card -->
                        <div class="col-lg-6">
                            <div class="card bg-white border-0 shadow-sm rounded-3 h-100">
                                <div class="card-body p-4">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h5 class="fw-bold mb-0"><i class="bi bi-clipboard2-data text-primary me-2"></i>
                                            Visit Details</h5>
                                        <% if (appointment.clinical_status==='labs_pending' ) { %>
                                            <span class="badge bg-warning text-dark"><i class="bi bi-droplet me-1"></i>
                                                Awaiting Labs</span>
                                            <% } else if (appointment.status==='booked' ) { %>
                                                <span class="badge bg-success text-white">Upcoming</span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary text-white">
                                                        <%= appointment.status %>
                                                    </span>
                                                    <% } %>
                                    </div>

                                    <ul class="list-group list-group-flush mt-3">
                                        <li class="list-group-item px-0 border-light d-flex justify-content-between">
                                            <span class="text-muted">Date & Time</span>
                                            <span class="fw-semibold text-dark">
                                                <%= new Date(appointment.date).toLocaleDateString('en-CA') %> @ <%=
                                                        appointment.start_time ? appointment.start_time.substring(0,5)
                                                        : '—' %>
                                            </span>
                                        </li>
                                        <li class="list-group-item px-0 border-light d-flex justify-content-between">
                                            <span class="text-muted">Chief Complaint</span>
                                            <span class="fw-semibold text-dark text-end" style="max-width: 60%;">
                                                <%= appointment.reason || 'None provided' %>
                                            </span>
                                        </li>
                                        <li class="list-group-item px-0 border-light d-flex justify-content-between">
                                            <span class="text-muted">Patient Name</span>
                                            <span class="fw-semibold text-dark">
                                                <%= appointment.pet_name %> (<%= appointment.species %>)
                                            </span>
                                        </li>
                                        <li class="list-group-item px-0 border-light d-flex justify-content-between">
                                            <span class="text-muted">Owner</span>
                                            <span class="fw-semibold text-dark">
                                                <%= appointment.owner_name %>
                                            </span>
                                        </li>
                                        <li class="list-group-item px-0 border-light d-flex justify-content-between">
                                            <span class="text-muted">Attending Vet</span>
                                            <span class="fw-semibold text-dark">Dr. <%= appointment.vet_name %></span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
    </div>
    </body>

    </html>