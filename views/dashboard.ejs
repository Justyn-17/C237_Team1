<%- include('partials/header') %>
    <%- include('partials/navbar') %>

        <main class="container">
            <div class="row mt-5">
                <div class="col-12">
                    <h1 class="mb-4 pb-2 border-bottom fw-bold" style="color: var(--primary-teal);">Vet Dashboard &
                        Reporting</h1>
                </div>
            </div>

            <!-- Key Metrics Row -->
            <div class="row mb-5">
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 bg-light">
                        <div class="card-body text-center py-4">
                            <h5 class="card-title text-muted fw-bold">Total Registered Pets</h5>
                            <p class="display-4 fw-bold" style="color: var(--primary-teal);">
                                <%= totalPets %>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 bg-light">
                        <div class="card-body text-center py-4">
                            <h5 class="card-title text-muted fw-bold">Appointments Today</h5>
                            <p class="display-4 fw-bold" style="color: var(--primary-teal);">
                                <%= todayAppts %>
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Reporting & Filtering Section -->
            <div class="row mb-3 align-items-center">
                <div class="col-md-6">
                    <h3 class="fw-bold m-0" style="color: var(--primary-teal);">Appointments Report</h3>
                </div>
                <div class="col-md-6 text-end">
                    <!-- Filter Form -->
                    <form action="/vet-dashboard" method="GET" class="d-inline-flex align-items-center">
                        <label for="statusFilter" class="me-2 fw-semibold">Filter by Status:</label>
                        <select name="status" id="statusFilter" class="form-select form-select-sm w-auto d-inline-block"
                            onchange="this.form.submit()">
                            <option value="" <%=currentFilter==='' ? 'selected' : '' %>>All Appointments</option>
                            <option value="booked" <%=currentFilter==='booked' ? 'selected' : '' %>>Booked</option>
                            <option value="completed" <%=currentFilter==='completed' ? 'selected' : '' %>>Completed
                            </option>
                            <option value="cancelled" <%=currentFilter==='cancelled' ? 'selected' : '' %>>Cancelled
                            </option>
                        </select>
                    </form>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <div class="table-responsive shadow-sm rounded">
                        <table class="table table-hover align-middle mb-0 bg-white">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Time</th>
                                    <th>Pet Name</th>
                                    <th>Species</th>
                                    <th>Reason</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (appointments.length> 0) { %>
                                    <% appointments.forEach(function(appt) { %>
                                        <tr>
                                            <td>
                                                <%= new Date(appt.date).toLocaleDateString() %>
                                            </td>
                                            <td>
                                                <%= appt.start_time %>
                                            </td>
                                            <td class="fw-semibold">
                                                <%= appt.pet_name %>
                                            </td>
                                            <td>
                                                <%= appt.species %>
                                            </td>
                                            <td>
                                                <%= appt.reason || 'N/A' %>
                                            </td>
                                            <td>
                                                <% if (appt.status==='booked' ) { %>
                                                    <span class="badge bg-primary">Booked</span>
                                                    <% } else if (appt.status==='completed' ) { %>
                                                        <span class="badge bg-success">Completed</span>
                                                        <% } else { %>
                                                            <span class="badge bg-danger">Cancelled</span>
                                                            <% } %>
                                            </td>
                                        </tr>
                                        <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="6" class="text-center py-4 text-muted">No appointments
                                                        match this filter.</td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
            crossorigin="anonymous"></script>
        </body>

        </html>