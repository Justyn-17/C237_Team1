<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PetCenter</title>
    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    
    <!-- Bootstrap 5 JS Bundle CDN (Added here globally so it initializes nav-tabs and mobile navbars) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous" defer></script>
    
    <style>
        :root {
            --primary-teal: #0d9488;
            --primary-teal-hover: #115e59;
        }
        body {
            background-color: #f8fafc;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }
        .text-teal {
            color: var(--primary-teal) !important;
        }
        .navbar {
            background-color: var(--primary-teal) !important;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }
        .btn-primary {
            background-color: var(--primary-teal) !important;
            border-color: var(--primary-teal) !important;
            transition: all 0.2s ease-in-out;
        }
        .btn-primary:hover {
            background-color: var(--primary-teal-hover) !important;
            border-color: var(--primary-teal-hover) !important;
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }
        .card {
            border: none;
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.05);
            transition: transform 0.2s;
        }
        .hero-section {
            background: linear-gradient(135deg, #0d9488 0%, #115e59 100%);
            color: white;
            border-radius: 1rem;
            padding: 5rem 2rem;
            margin-top: 2rem;
            box-shadow: 0 20px 25px -5px rgba(13, 148, 136, 0.3);
        }
    </style>
</head>
<body>
