<%- include('partials/header') %>
<main class="container-fluid p-0 vh-100">
    <div class="row g-0 h-100">
        <div class="col-md-6 col-lg-7 d-none d-md-block position-relative" style="background: linear-gradient(135deg, #0d9488 0%, #042f2e 100%);">
            <div class="position-absolute top-50 start-50 translate-middle w-100 text-center text-white px-4">
                <h1 class="display-3 fw-bold mb-3 text-shadow">Forgot Password</h1>
                <p class="fs-4 fw-light text-shadow">Recover your account securely.</p>
            </div>
            <a href="/login" class="position-absolute top-0 start-0 m-4 text-white text-decoration-none fw-semibold fs-5 text-shadow">
                &larr; Back to Login
            </a>
        </div>
        <div class="col-md-6 col-lg-5 bg-white d-flex align-items-center justify-content-center px-4 py-5">
            <div class="w-100" style="max-width: 450px;">
                <a href="/login" class="d-md-none text-teal text-decoration-none fw-semibold mb-4 d-inline-block">
                    &larr; Back to Login
                </a>
                <h2 class="text-center mb-5 fw-bold" style="color: var(--primary-teal);">Account Recovery</h2>
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger text-center mb-4 shadow-sm" role="alert">
                        <%= error %>
                    </div>
                <% } %>
                <form action="/forgot-password" method="POST">
                    <div class="mb-4">
                        <label for="username" class="form-label text-secondary fw-semibold">Username</label>
                        <input type="text" class="form-control form-control-lg bg-light border-0 shadow-none" id="username" name="username" required placeholder="Enter your username">
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold shadow-sm mb-3">Continue</button>
                </form>
            </div>
        </div>
    </div>
</main>
</body>
</html>
