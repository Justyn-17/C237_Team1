<%- include('partials/header') %>

<div class="app-shell">
    <%- include('partials/customer-sidebar', { activePage: 'expenses' }) %>

    <div class="app-main">
        <div class="app-content">

            <div class="page-head">
                <div>
                    <h1 class="page-title">Billing & <span class="accent">Expenses</span></h1>
                    <p class="page-sub">View your pending invoices and paid expense log.</p>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-12 d-flex justify-content-center">
                    <div class="panel w-100" style="max-width: 600px;">
                        <div class="panel-head justify-content-center border-bottom-0 pb-0">
                            <h2 class="panel-title">This Month's Spending Breakdown</h2>
                        </div>
                        <div class="panel-body d-flex justify-content-center align-items-center" style="min-height: 250px;">
                            <% if (aggData && aggData.length > 0) { %>
                                <div style="width: 250px; height: 250px;">
                                    <canvas id="spendingPieChart"></canvas>
                                </div>
                            <% } else { %>
                                <p class="text-muted text-center mb-0">No paid expenses recorded this month.</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pending Invoices -->
            <div class="panel mb-4">
                <div class="panel-head flex-wrap">
                    <h2 class="panel-title">Pending Invoices</h2>
                </div>

                <% if (pendingInvoices && pendingInvoices.length === 0) { %>
                    <div class="empty-state">
                        <span class="empty-emoji">🎉</span>
                        <h6>All caught up!</h6>
                        <p>You have no pending invoices.</p>
                    </div>
                <% } else if (pendingInvoices) { %>
                    <div class="table-responsive">
                        <table class="app-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Category</th>
                                    <th>Pet</th>
                                    <th>Description</th>
                                    <th>Amount</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <% pendingInvoices.forEach(inv => { %>
                                    <tr>
                                        <td><%= new Date(inv.created_at).toLocaleDateString() %></td>
                                        <td><span class="chip chip-amber"><%= inv.category %></span></td>
                                        <td><%= inv.pet_name || '—' %></td>
                                        <td><%= inv.title %></td>
                                        <td class="fw-semibold text-danger">$<%= Number(inv.amount).toFixed(2) %></td>
                                        <td class="text-end">
                                            <a href="/checkout/<%= inv.id %>" class="btn btn-sm btn-primary">
                                                <i class="bi bi-credit-card"></i> Pay Now
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>

            <!-- Paid Expense Log -->
            <div class="panel">
                <div class="panel-head flex-wrap">
                    <h2 class="panel-title">Paid Expense Log</h2>
                </div>

                <% if (expenses && expenses.length === 0) { %>
                    <div class="empty-state">
                        <span class="empty-emoji">🐾</span>
                        <h6>No expenses logged</h6>
                        <p>No paid invoices yet.</p>
                    </div>
                <% } else if (expenses) { %>
                    <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                        <table class="app-table">
                            <thead>
                                <tr>
                                    <th>Date Paid</th>
                                    <th>Category</th>
                                    <th>Pet</th>
                                    <th>Description</th>
                                    <th>Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% expenses.forEach(exp => { %>
                                    <tr>
                                        <td><%= new Date(exp.expense_date).toLocaleDateString() %></td>
                                        <td><span class="chip chip-teal"><%= exp.category %></span></td>
                                        <td><%= exp.pet_name || '—' %></td>
                                        <td><%= exp.description || '—' %></td>
                                        <td class="fw-semibold">$<%= Number(exp.amount).toFixed(2) %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>

        </div>
    </div>
</div>

</div>
<script id="aggData" type="application/json">
    <%- JSON.stringify(aggData || []) %>
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const canvas = document.getElementById('spendingPieChart');
        if (!canvas) return;
        
        const ctx = canvas.getContext('2d');
        const rawData = JSON.parse(document.getElementById('aggData').textContent);
        
        const labels = rawData.map(d => d.category);
        const data = rawData.map(d => d.total);
        const bgColors = ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40', '#E7E9ED', '#8A2BE2'];
        
        new Chart(ctx, {
            type: 'pie',
            data: {
                labels: labels,
                datasets: [{
                    data: data,
                    backgroundColor: bgColors.slice(0, data.length),
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });
    });
</script>
</body>
</html>
