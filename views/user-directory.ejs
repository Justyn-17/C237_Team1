<%- include('partials/header') %>
<% const isSuperAdmin = (typeof role !== 'undefined' && role === 'admin') || (typeof currentUser !== 'undefined' && currentUser.username === 'admin'); %>

<div class="staff-shell">
  <%- include('partials/staff-sidebar', { activePage: 'users' }) %>
  <main class="staff-main">
    <div class="container-fluid p-4">
      <main class="container-fluid px-4 mt-4">
    <div class="row mb-5">
        <div class="col-12 text-center">
            <h1 class="display-5 fw-bold" style="color: var(--primary-teal);">User Directory</h1>
            <p class="text-muted fs-5">Manage staff accounts and view all system users.</p>
        </div>
    </div>

    <% if (typeof addedUsers !== 'undefined' && addedUsers.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show shadow-sm text-center mb-4" role="alert" style="border: 2px solid #0d9488; background-color: #f0fdfa;">
            <h4 class="alert-heading fw-bold mb-3" style="color: #0f766e;">Staff Account(s) Created Successfully!</h4>
            <p class="mb-2 fs-5">Please provide the new staff members with their one-time access codes:</p>
            <div class="d-flex flex-wrap justify-content-center gap-3 my-3">
                <% addedUsers.forEach(function(u) { %>
                    <div class="p-3 bg-white rounded shadow-sm text-center" style="min-width: 200px; border: 1px solid #ccfbf1;">
                        <strong><%= u.username %></strong><br>
                        <span class="fs-4 fw-bold" style="color: #0d9488; letter-spacing: 2px;"><%= u.accessCode %></span>
                    </div>
                <% }); %>
            </div>
            <p class="text-muted mb-0"><i class="bi bi-info-circle me-1"></i>They will be prompted to set a permanent password upon their first login.</p>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <% if (typeof failedUsers !== 'undefined' && failedUsers.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-5" role="alert">
            <h4 class="alert-heading fw-bold mb-2">Some Accounts Could Not Be Created</h4>
            <ul class="mb-0 text-start d-inline-block">
                <% failedUsers.forEach(function(u) { %>
                    <li><strong><%= u.username %></strong>: <%= u.error %></li>
                <% }); %>
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <% if (typeof resetAccessCode !== 'undefined' && resetAccessCode) { %>
        <div class="alert alert-warning alert-dismissible fade show shadow-sm text-center mb-5" role="alert" style="border: 2px solid #d97706; background-color: #fef3c7;">
            <h4 class="alert-heading fw-bold mb-3" style="color: #b45309;">Access Code Regenerated!</h4>
            <p class="mb-2 fs-5">A new access code has been generated for <strong><%= resetUsername %></strong>.</p>
            <p class="mb-0">Please provide them with the following temporary access code:</p>
            <div class="display-4 fw-bold my-3 p-3 bg-white rounded d-inline-block shadow" style="color: #d97706; letter-spacing: 2px;">
                <%= resetAccessCode %>
            </div>
            <p class="text-muted mb-0"><i class="bi bi-info-circle me-1"></i>They will be prompted to set a permanent password upon their next login.</p>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <div class="d-flex flex-row align-items-start w-100" style="gap: 1.5rem;">
        <!-- Add Staff Panel (Collapse) -->
        <div class="collapse collapse-horizontal" id="addStaffPanel" style="will-change: width; transform: translateZ(0);">
            <div style="width: 320px; overflow: hidden;">
                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-header bg-white border-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0" style="color: #0d9488;">
                            <i class="bi bi-person-plus-fill me-2"></i> Add Staff Member
                        </h5>
                        <button type="button" class="btn-close shadow-none" data-bs-toggle="collapse" data-bs-target="#addStaffPanel" aria-label="Close"></button>
                    </div>
                    <div class="card-body p-4">
                        <!-- TODO(security): Add CSRF token for production -->
                        <form action="/staff/create-user" method="POST">
                            <div id="staffFormContainer">
                                <div class="staff-form-group position-relative mb-4 pb-3 border-bottom">
                                    <div class="mb-3">
                                        <label class="form-label text-secondary fw-semibold">Full Name</label>
                                        <input type="text" class="form-control form-control-lg bg-light border-0 shadow-none" name="users[0][name]" required placeholder="e.g. John Doe">
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label text-secondary fw-semibold">Username</label>
                                        <input type="text" class="form-control form-control-lg bg-light border-0 shadow-none" name="users[0][username]" required placeholder="e.g. jdoe">
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label text-secondary fw-semibold">Phone Number</label>
                                        <input type="text" class="form-control form-control-lg bg-light border-0 shadow-none" name="users[0][phone]" required placeholder="e.g. 555-0123">
                                    </div>
                                </div>
                            </div>
                            <button type="button" id="addStaffBtn" class="btn btn-outline-secondary btn-lg w-100 rounded-pill fw-bold shadow-sm mb-3">
                                + Add another staff
                            </button>
                            <button type="submit" class="btn btn-lg w-100 rounded-pill fw-bold shadow-sm text-white" style="background-color: #0d9488;">
                                Create Account(s)
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Users Tabbed Interface -->
        <div class="flex-grow-1 overflow-hidden" style="transition: width 0.35s ease, margin 0.35s ease; min-width: 0;">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body p-4">
                    
                    <!-- Header & Search Input -->
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
                        <h4 class="fw-bold mb-0" style="color: #334155;">Active Users</h4>
                        <div class="d-flex gap-2">
                            <div class="input-group" style="max-width: 400px;">
                                <span class="input-group-text bg-light border-0 text-muted">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/></svg>
                                </span>
                                <input type="text" id="searchInput" class="form-control bg-light border-0 shadow-none py-2" placeholder="Search by name, username, or phone...">
                            </div>
                            <select id="requestFilter" class="form-select form-select-sm w-auto ms-2">
                                <option value="all">All Users</option>
                                <option value="delete">Account Delete Request</option>
                                <option value="password">Password Reset Request</option>
                            </select>
                            <button class="btn btn-success text-white fw-semibold shadow-sm ms-2" style="white-space: nowrap;" type="button" data-bs-toggle="collapse" data-bs-target="#addStaffPanel" aria-expanded="false" aria-controls="addStaffPanel">
                                <i class="bi bi-person-plus me-1"></i> Add Staff Member
                            </button>
                        </div>
                    </div>

                    <% const isCustomersTab = typeof activeTab !== 'undefined' && activeTab === 'customers'; %>
                    
                    <!-- Bootstrap Nav Pills -->
                    <ul class="nav nav-pills mb-4 gap-2" id="userTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link <%= !isCustomersTab ? 'active' : '' %> rounded-pill px-4 fw-semibold custom-pill" id="staff-tab" data-bs-toggle="pill" data-bs-target="#staff-pane" type="button" role="tab" aria-controls="staff-pane" aria-selected="<%= !isCustomersTab %>">Staff</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link <%= isCustomersTab ? 'active' : '' %> rounded-pill px-4 fw-semibold custom-pill" id="customers-tab" data-bs-toggle="pill" data-bs-target="#customers-pane" type="button" role="tab" aria-controls="customers-pane" aria-selected="<%= isCustomersTab %>">Customers</button>
                        </li>
                    </ul>

                    <!-- Tab Content -->
                    <div class="tab-content" id="userTabsContent">
                        
                        <!-- Staff Tab Pane -->
                        <div class="tab-pane fade <%= !isCustomersTab ? 'show active' : '' %>" id="staff-pane" role="tabpanel" aria-labelledby="staff-tab" tabindex="0">
                            <div class="table-responsive" style="overflow-x: auto;">
                                <table class="table table-hover align-middle mb-0">
                                    <thead style="background-color: #f8fafc;">
                                        <tr>
                                            <th scope="col" class="fw-semibold text-secondary py-3 rounded-start" style="width: 15%;">Name</th>
                                            <th scope="col" class="fw-semibold text-secondary py-3" style="width: 15%;">Username</th>
                                            <th scope="col" class="fw-semibold text-secondary py-3" style="width: 15%;">Phone</th>
                                            <th scope="col" class="fw-semibold text-secondary py-3" style="width: 10%;">Role</th>
                                            <th scope="col" class="fw-semibold text-secondary py-3" style="width: 20%; min-width: 160px;">Status</th>
                                            <th scope="col" class="fw-semibold text-secondary py-3 rounded-end" style="width: 25%; min-width: 260px; text-align: right;">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="staffTableBody">
                                        <% const staffUsers = users.filter(u => (u.role === 'staff' || u.role === 'admin') && u.status !== 'deleted'); %>
                                        <% staffUsers.forEach(function(user) { %>
                                            <tr class="searchable-row">
                                                <td class="py-3 align-middle">
                                                    <span class="fw-bold searchable-name" style="color: #1e293b;"><%= user.name %></span>
                                                </td>
                                                <td class="py-3 align-middle text-muted searchable-username"><%= user.username %></td>
                                                <td class="py-3 align-middle text-muted searchable-phone"><%= user.phone || 'N/A' %></td>
                                                <td class="py-3 align-middle">
                                                    <% if (user.role === 'admin') { %>
                                                      <span class="fw-semibold">Admin</span>
                                                    <% } else if (user.role === 'staff') { %>
                                                      <span class="badge bg-dark rounded-pill px-3 py-2">Staff</span>
                                                    <% } else { %>
                                                      <span class="badge bg-secondary rounded-pill px-3 py-2">Customer</span>
                                                    <% } %>
                                                </td>
                                                <td class="py-3 align-middle text-nowrap">
                                                  <div class="d-flex flex-column align-items-start gap-1">
                                                    <% if (user.requires_password_reset) { %>
                                                        <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-circle"></i> Pending Setup</span>
                                                    <% } else { %>
                                                        <span class="badge bg-success"><i class="bi bi-check-circle"></i> Active</span>
                                                    <% } %>
                                                    <% if (user.password_reset_requested) { %>
                                                        <span class="badge bg-warning text-dark"><i class="bi bi-key-fill me-1"></i>Reset Req.</span>
                                                    <% } %>
                                                  </div>
                                                </td>
                                                <td class="py-3 align-middle text-nowrap text-end">
                                                    <% if (user.username !== 'admin') { %>
                                                        <div class="d-flex align-items-center justify-content-end gap-1 gap-xl-2 flex-nowrap">
                                                            <% if (typeof currentUser !== 'undefined' && currentUser.username === 'admin') { %>
                                                                <form action="/admin/delete-staff/<%= user.id %>" method="POST" onsubmit="return confirm('Are you sure you want to permanently delete this user? This action cannot be undone.');" class="m-0 p-0">
                                                                    <button type="submit" class="btn btn-outline-danger btn-sm py-1 px-2 text-nowrap">Delete</button>
                                                                </form>
                                                            <% } %>
                                                            <% if (isSuperAdmin || user.role === 'customer') { %>
                                                              <form action="/staff/reset-user/<%= user.id %>" method="POST" class="m-0 p-0">
                                                                <% if (user.password_reset_requested) { %>
                                                                  <button type="submit" class="btn btn-warning btn-sm py-1 px-2 fw-bold text-nowrap">Approve Reset</button>
                                                                <% } else { %>
                                                                  <button type="submit" class="btn btn-outline-warning btn-sm py-1 px-2 text-dark text-nowrap">Reset Code</button>
                                                                <% } %>
                                                              </form>
                                                            <% } %>
                                                        </div>
                                                    <% } %>
                                                </td>
                                            </tr>
                                        <% }); %>
                                        <% if(staffUsers.length === 0) { %>
                                            <tr class="no-results-row"><td colspan="6" class="text-center text-muted py-5">No staff users found.</td></tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Customers Tab Pane -->
                        <div class="tab-pane fade <%= isCustomersTab ? 'show active' : '' %>" id="customers-pane" role="tabpanel" aria-labelledby="customers-tab" tabindex="0">
                            <div class="table-responsive" style="overflow-x: auto;">
                                <table class="table table-hover align-middle mb-0">
                                    <thead style="background-color: #f8fafc;">
                                        <tr>
                                            <th scope="col" class="fw-semibold text-secondary py-3 rounded-start" style="width: 15%;">Name</th>
                                            <th scope="col" class="fw-semibold text-secondary py-3" style="width: 15%;">Username</th>
                                            <th scope="col" class="fw-semibold text-secondary py-3" style="width: 15%;">Phone</th>
                                            <th scope="col" class="fw-semibold text-secondary py-3" style="width: 10%;">Role</th>
                                            <th scope="col" class="fw-semibold text-secondary py-3" style="width: 20%; min-width: 160px;">Status</th>
                                            <th scope="col" class="fw-semibold text-secondary py-3 rounded-end" style="width: 25%; min-width: 260px; text-align: right;">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="customersTableBody">
                                        <% const customerUsers = users.filter(u => u.role === 'customer' && u.status !== 'deleted'); %>
                                        <% customerUsers.forEach(function(user) { %>
                                            <tr class="searchable-row">
                                                <td class="py-3 align-middle">
                                                    <span class="fw-bold searchable-name" style="color: #1e293b;"><%= user.name %></span>
                                                </td>
                                                <td class="py-3 align-middle text-muted searchable-username"><%= user.username %></td>
                                                <td class="py-3 align-middle text-muted searchable-phone"><%= user.phone || 'N/A' %></td>
                                                <td class="py-3 align-middle">
                                                    <% if (user.role === 'admin') { %>
                                                      <span class="fw-semibold">Admin</span>
                                                    <% } else if (user.role === 'staff') { %>
                                                      <span class="badge bg-dark rounded-pill px-3 py-2">Staff</span>
                                                    <% } else { %>
                                                      <span class="badge bg-secondary rounded-pill px-3 py-2">Customer</span>
                                                    <% } %>
                                                </td>
                                                <td class="py-3 align-middle text-nowrap">
                                                  <div class="d-flex flex-column align-items-start gap-1">
                                                    <% if (user.status === 'deletion_requested') { %>
                                                      <span class="badge bg-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>Pending Deletion</span>
                                                    <% } else { %>
                                                      <span class="badge bg-success"><i class="bi bi-check-circle"></i> Active</span>
                                                    <% } %>
                                                    <% if (user.password_reset_requested) { %>
                                                      <span class="badge bg-warning text-dark"><i class="bi bi-key-fill me-1"></i>Reset Req.</span>
                                                    <% } %>
                                                  </div>
                                                </td>
                                                <td class="py-3 align-middle text-nowrap text-end">
                                                    <% if (user.username !== 'admin') { %>
                                                        <div class="d-flex align-items-center justify-content-end gap-1 gap-xl-2 flex-nowrap">
                                                          <% if (isSuperAdmin) { %>
                                                            <!-- Super Admin sees the direct Delete button -->
                                                            <form action="/admin/delete-customer/<%= user.id %>" method="POST" onsubmit="return confirm('Are you sure you want to permanently delete this user? This action cannot be undone.');" class="m-0 p-0">
                                                              <% if (user.status === 'deletion_requested') { %>
                                                                <button type="submit" class="btn btn-danger btn-sm py-1 px-2 fw-bold text-nowrap">Confirm Deletion</button>
                                                              <% } else { %>
                                                                <button type="submit" class="btn btn-outline-danger btn-sm py-1 px-2 text-nowrap">Delete</button>
                                                              <% } %>
                                                            </form>
                                                          <% } else if (user.status === 'deletion_requested') { %>
                                                            <!-- Standard Staff sees Approve Deletion ONLY if requested -->
                                                            <form action="/staff/approve-deletion/<%= user.id %>" method="POST" onsubmit="return confirm('Are you sure you want to permanently delete this user?');" class="m-0 p-0">
                                                              <button type="submit" class="btn btn-danger btn-sm py-1 px-2 fw-bold text-nowrap">Confirm Deletion</button>
                                                            </form>
                                                          <% } %>
                                                          
                                                          <% if (user.status === 'deletion_requested') { %>
                                                            <form action="/cancel-deletion-request/<%= user.id %>" method="POST" class="m-0 p-0">
                                                              <button type="submit" class="btn btn-outline-secondary btn-sm py-1 px-2 text-nowrap" title="Cancel Request">Cancel</button>
                                                            </form>
                                                          <% } %>

                                                          <% if (isSuperAdmin || user.role === 'customer') { %>
                                                            <form action="/staff/reset-user/<%= user.id %>" method="POST" class="m-0 p-0">
                                                              <% if (user.password_reset_requested) { %>
                                                                <button type="submit" class="btn btn-warning btn-sm py-1 px-2 fw-bold text-nowrap">Approve Reset</button>
                                                              <% } else { %>
                                                                <button type="submit" class="btn btn-outline-warning btn-sm py-1 px-2 text-dark text-nowrap">Reset Code</button>
                                                              <% } %>
                                                            </form>
                                                          <% } %>
                                                        </div>
                                                    <% } %>
                                                </td>
                                            </tr>
                                        <% }); %>
                                        <% if(customerUsers.length === 0) { %>
                                            <tr class="no-results-row"><td colspan="6" class="text-center text-muted py-5">No customer users found.</td></tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
    </div>
  </main>
</div>

<style>
    td {
        word-wrap: break-word;
    }
    td.searchable-username, td.searchable-phone {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .searchable-name {
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 100%;
    }
    .form-control:focus {
        border-color: #0d9488 !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 148, 136, 0.25) !important;
    }
    .btn:hover {
        opacity: 0.9;
        transform: translateY(-1px);
    }
    .custom-pill {
        color: #64748b;
        background-color: transparent;
        border: 1px solid transparent;
        transition: all 0.2s ease;
    }
    .nav-pills .nav-link.active.custom-pill {
        background-color: #0d9488 !important;
        color: white !important;
        box-shadow: 0 4px 6px -1px rgba(13, 148, 136, 0.3);
    }
    .custom-pill:hover:not(.active) {
        background-color: #f1f5f9;
        color: #0f766e;
    }
</style>

<!-- Vanilla JS Search Filter -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.getElementById('searchInput');
        const requestFilter = document.getElementById('requestFilter');
        
        function applyFilters() {
            const query = searchInput.value.toLowerCase().trim();
            const filterValue = requestFilter ? requestFilter.value : 'all';
            const activeTabPane = document.querySelector('.tab-pane.active');
            if (!activeTabPane) return;
            
            const rows = activeTabPane.querySelectorAll('.searchable-row');

            rows.forEach(row => {
                const name = row.querySelector('.searchable-name')?.textContent.toLowerCase() || '';
                const username = row.querySelector('.searchable-username')?.textContent.toLowerCase() || '';
                const phone = row.querySelector('.searchable-phone')?.textContent.toLowerCase() || '';
                
                let matchesSearch = name.includes(query) || username.includes(query) || phone.includes(query);
                
                let matchesFilter = true;
                if (filterValue !== 'all') {
                    matchesFilter = false;
                    const badges = row.querySelectorAll('.request-tag');
                    badges.forEach(badge => {
                        const text = (badge.innerText || badge.textContent).trim();
                        if (filterValue === 'delete' && text === 'Account Delete Request') {
                            matchesFilter = true;
                        }
                        if (filterValue === 'password' && text === 'Password Reset Request') {
                            matchesFilter = true;
                        }
                    });
                }

                if (matchesSearch && matchesFilter) {
                    row.style.display = ''; // Show
                } else {
                    row.style.display = 'none'; // Hide
                }
            });
        }

        searchInput.addEventListener('input', applyFilters);
        if (requestFilter) {
            requestFilter.addEventListener('change', applyFilters);
        }

        // Re-run search when tabs change so the filter applies to the newly active tab instantly
        const tabElements = document.querySelectorAll('button[data-bs-toggle="pill"]');
        tabElements.forEach(tab => {
            tab.addEventListener('shown.bs.tab', applyFilters);
        });
    });
</script>

<!-- Dynamic Form Handling -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const addBtn = document.getElementById('addStaffBtn');
        const container = document.getElementById('staffFormContainer');
        let index = 1;

        if (addBtn && container) {
            addBtn.addEventListener('click', () => {
                const group = container.querySelector('.staff-form-group').cloneNode(true);
                
                // Update names
                group.querySelectorAll('input').forEach(input => {
                    const originalName = input.getAttribute('name');
                    const newName = originalName.replace(/\[\d+\]/, `[${index}]`);
                    input.setAttribute('name', newName);
                    input.value = ''; // clear values
                });

                // Add remove button properly into the header
                const firstLabel = group.querySelector('label');
                if (firstLabel) {
                    firstLabel.outerHTML = `
<div class="d-flex justify-content-between align-items-center mb-1">
  <label class="form-label small text-uppercase text-muted fw-bold mb-0">Full Name</label>
  <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2 remove-staff-btn"><i class="bi bi-x"></i> Remove</button>
</div>`;
                    const removeBtn = group.querySelector('.remove-staff-btn');
                    if (removeBtn) {
                        removeBtn.onclick = function() {
                            group.remove();
                        };
                    }
                }
                
                container.appendChild(group);
                index++;
            });
        }
    });
</script>

</body>
</html>
