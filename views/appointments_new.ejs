<%- include('partials/header') %>

<div class="app-shell">
  <%- include('partials/customer-sidebar', { activePage: 'book' }) %>

  <main class="app-main">
    <%- include('partials/customer-topbar') %>

    <div class="app-content">

      <div class="page-head">
        <div>
          <h1 class="page-title">Book an <span class="accent">Appointment</span></h1>
          <p class="page-sub">Pick a pet, a vet, and a time slot — we'll block out double bookings automatically.</p>
        </div>
        <a href="/customer-dashboard" class="btn btn-outline-secondary rounded-pill px-4">
          <i class="bi bi-arrow-left me-1"></i> Back
        </a>
      </div>

      <form action="/appointments" method="POST">
        <div class="row g-3">

          <!-- Main form -->
          <div class="col-lg-8">
            <div class="panel mb-3">
              <div class="panel-body">
                <div class="form-section-title">Visit details</div>

                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label-sm d-block">Pet</label>
                    <select name="pet_id" class="form-select app-input" required>
                      <option value="" disabled selected>Select a pet</option>
                      <% pets.forEach(function(pet) { %>
                        <option value="<%= pet.id %>">
                          <%= pet.name %> (<%= pet.species %><%= pet.breed ? ' – ' + pet.breed : '' %>)
                        </option>
                      <% }); %>
                    </select>
                    <% if (pets.length === 0) { %>
                      <div class="form-text text-danger">
                        You need a registered pet first — <a href="/addpet">add one here</a>.
                      </div>
                    <% } %>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label-sm d-block">Appointment Date</label>
                    <input type="date" name="date" class="form-control app-input" required>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label-sm d-block">Vet</label>
                    <select name="vet_id" class="form-select app-input" required>
                      <option value="" disabled selected>Select a vet</option>
                      <% vets.forEach(function(vet) { %>
                        <option value="<%= vet.id %>"><%= vet.name %></option>
                      <% }); %>
                    </select>
                    <% if (vets.length === 0) { %>
                      <div class="form-text text-danger">No vets are available right now. Please try again later.</div>
                    <% } %>
                  </div>
                </div>

                <hr class="my-4" style="opacity:.08">

                <div class="form-section-title">Pick a time slot</div>
                <div class="d-flex flex-wrap gap-2">
                  <% const slots = [
                       ['10:00:00', '10:00 AM'], ['11:00:00', '11:00 AM'], ['12:00:00', '12:00 PM'],
                       ['13:00:00', '1:00 PM'],  ['14:00:00', '2:00 PM'],  ['15:00:00', '3:00 PM'],
                       ['16:00:00', '4:00 PM'],  ['17:00:00', '5:00 PM'],  ['18:00:00', '6:00 PM']
                     ]; %>
                  <% slots.forEach(function(slot, i) { %>
                    <div>
                      <input class="btn-check" type="radio" name="slot_time"
                             id="slot-<%= i %>" value="<%= slot[0] %>" <%= i === 0 ? 'required' : '' %>>
                      <label class="btn btn-outline-primary rounded-pill px-3 py-2" for="slot-<%= i %>">
                        <%= slot[1] %>
                      </label>
                    </div>
                  <% }); %>
                </div>
                <div class="form-text text-muted mt-2">
                  If a slot is already taken for that vet on that date, the booking will be rejected.
                </div>

                <hr class="my-4" style="opacity:.08">

                <div class="form-section-title">Reason for visit</div>
                <textarea name="reason" class="form-control app-input" rows="3"
                          placeholder="Routine checkup, vaccination, grooming, etc."></textarea>
              </div>
            </div>

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
              <a href="/customer-dashboard" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
              <button type="submit" class="btn btn-primary btn-lg rounded-pill px-4 fw-bold shadow-sm">
                <i class="bi bi-calendar-check me-1"></i> Confirm Appointment
              </button>
            </div>
          </div>

          <!-- Helper column -->
          <div class="col-lg-4">
            <div class="panel">
              <div class="panel-head">
                <h6 class="panel-title">Good to know</h6>
              </div>
              <div class="panel-body">
                <div class="d-flex gap-3 mb-3">
                  <i class="bi bi-clock-history fs-5" style="color: var(--primary-teal);"></i>
                  <div>
                    <div class="fw-semibold text-dark small">One hour per slot</div>
                    <div class="text-muted small">Each booking reserves a full hour with your vet.</div>
                  </div>
                </div>
                <div class="d-flex gap-3 mb-3">
                  <i class="bi bi-shield-check fs-5" style="color: var(--primary-teal);"></i>
                  <div>
                    <div class="fw-semibold text-dark small">No double bookings</div>
                    <div class="text-muted small">Taken slots are rejected before they're saved.</div>
                  </div>
                </div>
                <div class="d-flex gap-3">
                  <i class="bi bi-x-circle fs-5" style="color: var(--primary-teal);"></i>
                  <div>
                    <div class="fw-semibold text-dark small">Free to cancel</div>
                    <div class="text-muted small">Cancel anytime from My Appointments.</div>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </form>

    </div>
  </main>
</div>

</body>
</html>
