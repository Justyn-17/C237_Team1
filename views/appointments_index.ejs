<%- include('partials/header') %>
<% var admin = (typeof isAdmin !== 'undefined') && isAdmin; %>

<% if (admin || role === 'staff') { %>
  <div class="staff-shell">
    <%- include('partials/staff-sidebar', { activePage: 'appointments' }) %>
    <main class="staff-main">
      <div class="container-fluid p-4">
        <main class="container mt-4">
<% } else { %>
  <%- include('partials/navbar') %>
  <main class="container mt-4">
<% } %>

  <div class="card rounded-4 border-0 shadow-sm">
    <div class="card-body p-4 p-md-5">

      <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div>
          <h2 class="mb-1 fw-bold" style="color: var(--primary-teal);">
            <%= admin ? 'All Appointments' : 'Your Appointments' %>
          </h2>
          <p class="text-muted mb-0">
            <%= admin ? 'Every appointment across all vets.' : 'View upcoming bookings and check their status.' %>
          </p>
        </div>

        <div class="mt-3 mt-md-0">
          <% if (role === 'customer') { %>
            <a href="/appointments/new" class="btn btn-primary rounded-pill px-4 fw-bold">
              + New Appointment
            </a>
          <% } else if (admin) { %>
            <span class="badge bg-light text-teal border">
              Admin view &middot; all vets
            </span>
          <% } else if (role === 'staff') { %>
            <span class="badge bg-light text-teal border">
              Staff view &middot; showing appointments for this vet
            </span>
          <% } %>
        </div>
      </div>

      <% if (role === 'staff') { %>
        <%
          var currentStatus = (typeof statusFilter !== 'undefined') ? statusFilter : '';
          var currentRange  = (typeof rangeFilter  !== 'undefined') ? rangeFilter  : '';
          var currentFrom   = (typeof fromDate     !== 'undefined') ? fromDate     : '';
          var currentTo     = (typeof toDate       !== 'undefined') ? toDate       : '';
          var usingDates    = !!(currentFrom || currentTo);

          // Keep the status choice when switching date presets, and vice versa.
          var statusQs = currentStatus ? 'status=' + currentStatus : '';
          var dateQs   = usingDates
            ? [currentFrom ? 'from=' + currentFrom : '', currentTo ? 'to=' + currentTo : ''].filter(Boolean).join('&')
            : (currentRange ? 'range=' + currentRange : '');
          var link = function (parts) {
            var qs = parts.filter(Boolean).join('&');
            return '/appointments' + (qs ? '?' + qs : '');
          };
        %>

        <div class="d-flex flex-wrap gap-3 align-items-end mb-3">

          <div>
            <div class="text-muted small fw-semibold mb-1">Status</div>
            <div class="btn-group" role="group" aria-label="Filter by status">
              <a href="<%= link([dateQs]) %>"
                 class="btn btn-sm <%= currentStatus === '' ? 'btn-primary' : 'btn-outline-primary' %>">All</a>
              <a href="<%= link(['status=booked', dateQs]) %>"
                 class="btn btn-sm <%= currentStatus === 'booked' ? 'btn-primary' : 'btn-outline-primary' %>">Booked</a>
              <a href="<%= link(['status=completed', dateQs]) %>"
                 class="btn btn-sm <%= currentStatus === 'completed' ? 'btn-primary' : 'btn-outline-primary' %>">Completed</a>
              <a href="<%= link(['status=cancelled', dateQs]) %>"
                 class="btn btn-sm <%= currentStatus === 'cancelled' ? 'btn-primary' : 'btn-outline-primary' %>">Cancelled</a>
            </div>
          </div>

          <div>
            <div class="text-muted small fw-semibold mb-1">Date</div>
            <div class="btn-group" role="group" aria-label="Filter by date">
              <a href="<%= link([statusQs]) %>"
                 class="btn btn-sm <%= (!currentRange && !usingDates) ? 'btn-primary' : 'btn-outline-primary' %>">Any date</a>
              <a href="<%= link([statusQs, 'range=today']) %>"
                 class="btn btn-sm <%= currentRange === 'today' && !usingDates ? 'btn-primary' : 'btn-outline-primary' %>">Today</a>
              <a href="<%= link([statusQs, 'range=week']) %>"
                 class="btn btn-sm <%= currentRange === 'week' && !usingDates ? 'btn-primary' : 'btn-outline-primary' %>">Next 7 days</a>
              <a href="<%= link([statusQs, 'range=upcoming']) %>"
                 class="btn btn-sm <%= currentRange === 'upcoming' && !usingDates ? 'btn-primary' : 'btn-outline-primary' %>">Upcoming</a>
              <a href="<%= link([statusQs, 'range=past']) %>"
                 class="btn btn-sm <%= currentRange === 'past' && !usingDates ? 'btn-primary' : 'btn-outline-primary' %>">Past</a>
            </div>
          </div>

          <!-- Explicit date range; overrides the quick presets above -->
          <form action="/appointments" method="GET" class="d-flex align-items-end gap-2">
            <% if (currentStatus) { %>
              <input type="hidden" name="status" value="<%= currentStatus %>">
            <% } %>
            <div>
              <label class="text-muted small fw-semibold mb-1 d-block" for="fromDate">From</label>
              <input type="date" id="fromDate" name="from" value="<%= currentFrom %>"
                     class="form-control form-control-sm">
            </div>
            <div>
              <label class="text-muted small fw-semibold mb-1 d-block" for="toDate">To</label>
              <input type="date" id="toDate" name="to" value="<%= currentTo %>"
                     class="form-control form-control-sm">
            </div>
            <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3">Apply</button>
            <% if (usingDates) { %>
              <a href="<%= link([statusQs]) %>" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Clear</a>
            <% } %>
          </form>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small">
            Showing <strong><%= appointments ? appointments.length : 0 %></strong>
            appointment<%= (appointments && appointments.length === 1) ? '' : 's' %><%
              %><%= currentStatus ? ' · ' + currentStatus : '' %><%
              %><% if (usingDates) { %> · <%= currentFrom || 'any' %> to <%= currentTo || 'any' %><% } %>
          </span>
        </div>
      <% } %>

      <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col">Pet</th>
              <% if (admin) { %>
                <th scope="col">Owner</th>
                <th scope="col">Vet</th>
              <% } else { %>
                <th scope="col"><%= role === 'staff' ? 'Owner' : 'Vet' %></th>
              <% } %>
              <th scope="col">Date</th>
              <th scope="col">Time</th>
              <th scope="col">Status / Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (appointments && appointments.length) { %>
              <% appointments.forEach(a => { %>
                <tr>
                  <td>
                    <% if (a.pet_name) { %>
                      <%= a.pet_name %>
                    <% } else { %>
                      <span class="text-muted fst-italic">Deleted pet</span>
                    <% } %>
                  </td>
                  <% if (admin) { %>
                    <td><%= a.owner_name || '-' %></td>
                    <td><%= a.vet_name || '-' %></td>
                  <% } else { %>
                    <td><%= role === 'staff' ? (a.owner_name || '-') : (a.vet_name || '-') %></td>
                  <% } %>
                  <td>
                    <%= a.date && a.date.toISOString ? a.date.toISOString().slice(0, 10) : a.date %>
                  </td>
                  <td>
                    <% 
                      const timeStr = String(a.start_time || '');
                      const prettyTime = timeStr.length >= 5 ? timeStr.slice(0, 5) : timeStr;
                    %>
                    <%= prettyTime %>
                  </td>
                  <td>
                    <% if (a.status === 'booked') { %>
                      <span class="badge bg-primary">Booked</span>
                    <% } else if (a.status === 'completed') { %>
                      <span class="badge bg-success">Completed</span>
                    <% } else if (a.status === 'cancelled') { %>
                      <span class="badge bg-danger">Cancelled</span>
                    <% } else if (a.status === 'rescheduled') { %>
                      <span class="badge bg-warning text-dark">Rescheduled</span>
                    <% } else { %>
                      <span class="badge bg-secondary"><%= a.status %></span>
                    <% } %>

                    <% if (role === 'staff' && !admin && a.status === 'booked') { %>
                      <form action="/appointments/<%= a.id %>/complete" method="POST" class="d-inline ms-2">
                        <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3">
                          Mark Completed
                        </button>
                      </form>

                      <form action="/appointments/<%= a.id %>/cancel" method="POST" class="d-inline ms-2"
                            onsubmit="return confirm('Cancel this appointment?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                          Cancel
                        </button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="<%= admin ? 6 : 5 %>" class="text-center text-muted py-4">
                  <% if (role === 'staff' && (statusFilter || rangeFilter || fromDate || toDate)) { %>
                    No appointments match these filters.
                    <br/>
                    <a href="/appointments" class="btn btn-outline-primary btn-sm mt-2 rounded-pill px-3">
                      Clear filters
                    </a>
                  <% } else { %>
                  No appointments found yet.
                  <% } %>
                  <% if (role === 'customer') { %>
                    <br/>
                    <a href="/appointments/new" class="btn btn-primary btn-sm mt-2 rounded-pill px-3">
                      📅 Book your first appointment
                    </a>
                  <% } %>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<% if (admin || role === 'staff') { %>
      </div>
    </main>
  </div>
<% } %>

</body>
</html>
