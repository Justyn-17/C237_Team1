<%- include('partials/header') %>

<div class="app-shell">
  <%- include('partials/customer-sidebar', { activePage: 'dashboard' }) %>

  <main class="app-main">

    <div class="app-content">

      <div class="page-head">
        <div>
          <h1 class="page-title">Register a <span class="accent">New Pet</span></h1>
          <p class="page-sub">Add your pet's details so you can book visits and keep care records.</p>
        </div>
        <a href="/customer-dashboard" class="btn btn-outline-secondary rounded-pill px-4">
          <i class="bi bi-arrow-left me-1"></i> Back
        </a>
      </div>

      <%
        // Values are echoed back when the server rejects the form, so nothing is retyped.
        const f = typeof form !== 'undefined' && form ? form : {};
        const formError = typeof error !== 'undefined' ? error : null;
      %>

      <% if (formError) { %>
        <div class="alert alert-danger d-flex align-items-center gap-2 rounded-3 border-0 mb-3">
          <i class="bi bi-exclamation-triangle-fill"></i>
          <div><%= formError %></div>
        </div>
      <% } %>

      <form id="petForm" action="/addpet" method="POST" enctype="multipart/form-data" novalidate>
        <div class="row g-3">

          <div class="col-lg-8">
            <div class="panel mb-3">
              <div class="panel-body">
                <div class="form-section-title">Basic details</div>

                <div class="row g-3">
                  <!-- Max length 50 chars to prevent typing whole paragraphs as a name -->
                  <div class="col-md-6">
                    <label class="form-label-sm d-block" for="petName">Pet Name</label>
                    <input type="text" id="petName" name="name" class="form-control app-input"
                           maxlength="50" value="<%= f.name || '' %>" required>
                    <div class="invalid-feedback">Please enter your pet's name.</div>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label-sm d-block" for="speciesSelect">Species</label>
                    <select name="species" id="speciesSelect" class="form-select app-input" required>
                      <option value="" disabled <%= f.species ? '' : 'selected' %>>Select Species</option>
                      <option value="Dog"    <%= f.species === 'Dog'    ? 'selected' : '' %>>🐕 Dog</option>
                      <option value="Cat"    <%= f.species === 'Cat'    ? 'selected' : '' %>>🐈 Cat</option>
                      <option value="Bird"   <%= f.species === 'Bird'   ? 'selected' : '' %>>🐦 Bird</option>
                      <option value="Rabbit" <%= f.species === 'Rabbit' ? 'selected' : '' %>>🐰 Rabbit</option>
                    </select>
                    <div class="invalid-feedback">Please select a species.</div>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label-sm d-block" for="breedSelect">Breed</label>
                    <select name="breed" id="breedSelect" class="form-select app-input" required>
                      <option value="" disabled selected>Select a species first</option>
                    </select>
                    <div class="invalid-feedback">Please select a breed.</div>
                  </div>

                  <!-- Custom breed input for "Other" option -->
                  <div class="col-md-6" id="customBreedDiv" style="display: none;">
                    <label class="form-label-sm d-block" for="customBreedInput">Enter Custom Breed</label>
                    <input type="text" name="customBreed" id="customBreedInput"
                           class="form-control app-input" maxlength="50"
                           value="<%= f.customBreed || '' %>"
                           placeholder="e.g. Mixed Breed, Crossbreed">
                    <div class="invalid-feedback">Please type the breed name.</div>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label-sm d-block" for="genderSelect">Gender</label>
                    <select name="gender" id="genderSelect" class="form-select app-input" required>
                      <option value="" disabled <%= f.gender ? '' : 'selected' %>>Select Gender</option>
                      <option value="Male"    <%= f.gender === 'Male'    ? 'selected' : '' %>>Male</option>
                      <option value="Female"  <%= f.gender === 'Female'  ? 'selected' : '' %>>Female</option>
                      <option value="Unknown" <%= f.gender === 'Unknown' ? 'selected' : '' %>>Unknown</option>
                    </select>
                    <div class="invalid-feedback">Please select a gender.</div>
                  </div>

                  <!-- Age with decimal support for months -->
                  <div class="col-md-6">
                    <label class="form-label-sm d-block" for="petAge">Age (in years)</label>
                    <input type="number" id="petAge" name="age" step="0.1" class="form-control app-input"
                           min="0" max="50" value="<%= f.age || '' %>"
                           placeholder="e.g. 2 or 0.5 (for 6 months)" required>
                    <div class="invalid-feedback">Please enter an age between 0 and 50.</div>
                    <div class="form-text">Use decimals for months: 0.5 = 6 months, 0.25 = 3 months, 0.08 = 1 month</div>
                  </div>
                </div>
              </div>
            </div>

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
              <a href="/customer-dashboard" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
              <button type="submit" class="btn btn-primary btn-lg rounded-pill px-4 fw-bold shadow-sm">
                <i class="bi bi-save me-1"></i> Save Pet
              </button>
            </div>
          </div>

          <!-- Photo -->
          <div class="col-lg-4">
            <div class="panel">
              <div class="panel-head">
                <h6 class="panel-title">Pet Photo</h6>
              </div>
              <div class="panel-body text-center">
                <img id="photoPreview" src="<%= petPlaceholder %>" alt="Pet preview"
                     class="rounded-4 mb-3" style="width: 160px; height: 160px; object-fit: cover;">
                <!-- Optional pet photo, handled server-side by multer -->
                <input type="file" name="photo" id="photoInput" accept="image/png, image/jpeg, image/webp"
                       class="form-control app-input">
                <div class="form-text">JPG, PNG, or WEBP, up to 2MB. Optional.</div>
              </div>
            </div>
          </div>

        </div>
      </form>

    </div>
  </main>
</div>

<script>
    const breedOptions = {
        Dog: ['Labrador Retriever', 'Golden Retriever', 'German Shepherd', 'Bulldog', 'Poodle', 'Beagle', 'Husky', 'Dachshund', 'Boxer', 'Corgi'],
        Cat: ['Persian', 'Siamese', 'Maine Coon', 'British Shorthair', 'Bengal', 'Ragdoll', 'Sphynx', 'Scottish Fold', 'Tabby'],
        Bird: ['Parrot', 'Cockatiel', 'Canary', 'Budgie (Parakeet)', 'Lovebird', 'Finch', 'Macaw'],
        Rabbit: ['Holland Lop', 'Dwarf Hotot', 'Dutch Rabbit', 'Angora', 'Rex', 'Mini Lop', 'Lionhead']
    };

    const petForm = document.getElementById('petForm');
    const speciesSelect = document.getElementById('speciesSelect');
    const breedSelect = document.getElementById('breedSelect');
    const customBreedDiv = document.getElementById('customBreedDiv');
    const customBreedInput = document.getElementById('customBreedInput');

    // Breed the server sent back after a rejected submit, so the choice survives.
    const submittedBreed = <%- JSON.stringify((typeof form !== 'undefined' && form && form.breed) || '') %>;

    // Fills the breed list for the currently selected species. This runs on page
    // load as well as on change: without it, coming back to a page that already
    // has a species selected (browser Back button, or a re-rendered form) left the
    // breed dropdown empty with nothing to pick.
    function populateBreeds(keepBreed) {
        const selectedSpecies = speciesSelect.value;
        breedSelect.innerHTML = '';

        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.disabled = true;
        placeholder.textContent = selectedSpecies ? 'Select Breed' : 'Select a species first';
        breedSelect.appendChild(placeholder);

        if (!selectedSpecies || !breedOptions[selectedSpecies]) {
            placeholder.selected = true;
            customBreedDiv.style.display = 'none';
            customBreedInput.removeAttribute('required');
            return;
        }

        let matched = false;
        breedOptions[selectedSpecies].forEach(breed => {
            const option = document.createElement('option');
            option.value = breed;
            option.textContent = breed;
            if (keepBreed && breed === keepBreed) {
                option.selected = true;
                matched = true;
            }
            breedSelect.appendChild(option);
        });

        // Add "Other" option
        const otherOption = document.createElement('option');
        otherOption.value = 'other';
        otherOption.textContent = '➕ Other (enter custom breed)';
        breedSelect.appendChild(otherOption);

        if (keepBreed === 'other' || (keepBreed && !matched)) {
            otherOption.selected = true;
            customBreedDiv.style.display = 'block';
            customBreedInput.setAttribute('required', 'required');
        } else {
            if (!matched) placeholder.selected = true;
            customBreedDiv.style.display = 'none';
            customBreedInput.removeAttribute('required');
        }
    }

    speciesSelect.addEventListener('change', function () {
        customBreedInput.value = '';
        populateBreeds('');
    });

    breedSelect.addEventListener('change', function () {
        if (this.value === 'other') {
            customBreedDiv.style.display = 'block';
            customBreedInput.setAttribute('required', 'required');
            customBreedInput.focus();
        } else {
            customBreedDiv.style.display = 'none';
            customBreedInput.removeAttribute('required');
            customBreedInput.value = '';
        }
    });

    // Live preview of the chosen photo before upload
    const photoInput = document.getElementById('photoInput');
    photoInput.addEventListener('change', function() {
        const file = this.files && this.files[0];
        if (file) {
            document.getElementById('photoPreview').src = URL.createObjectURL(file);
        }
    });

    // Show a message under each field that still needs an answer, rather than
    // letting the server bounce the customer to a blank error page.
    petForm.addEventListener('submit', function (e) {
        if (!petForm.checkValidity()) {
            e.preventDefault();
            e.stopPropagation();
            petForm.classList.add('was-validated');
            const firstInvalid = petForm.querySelector(':invalid');
            if (firstInvalid) firstInvalid.focus();
        }
    });

    populateBreeds(submittedBreed);

    // Restoring from the browser's back/forward cache keeps the old selections but
    // not the generated <option> list, so rebuild it.
    window.addEventListener('pageshow', function (event) {
        if (event.persisted) populateBreeds(breedSelect.value || submittedBreed);
    });
</script>

</body>
</html>
