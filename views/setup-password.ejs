<%- include('partials/header') %>
<!-- Full screen layout without navbar for focus on setup -->
<main class="container-fluid p-0 vh-100">
    <div class="row g-0 h-100">
        
        <!-- Left Column: Branding (similar to login) -->
        <div class="col-md-6 col-lg-7 d-none d-md-block position-relative" style="background: linear-gradient(135deg, #0d9488 0%, #042f2e 100%);">
            <div class="position-absolute top-50 start-50 translate-middle w-100 text-center text-white px-4">
                <h1 class="display-3 fw-bold mb-3 text-shadow">Secure Your Account</h1>
                <p class="fs-4 fw-light text-shadow">Please set up a permanent password to continue.</p>
            </div>
            
            <a href="/logout" class="position-absolute top-0 start-0 m-4 text-white text-decoration-none fw-semibold fs-5 text-shadow">
                &larr; Cancel
            </a>
        </div>
        
        <!-- Right Column: Setup Form -->
        <div class="col-md-6 col-lg-5 bg-white d-flex align-items-center justify-content-center px-4 py-5">
            <div class="w-100" style="max-width: 450px;">
                <div class="text-center mb-5">
                    <div class="rounded-circle d-inline-flex justify-content-center align-items-center mb-3 shadow-sm" style="width: 80px; height: 80px; background-color: #f0fdfa; color: #0d9488;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-shield-lock-fill" viewBox="0 0 16 16">
                          <path fill-rule="evenodd" d="M8 0c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87a1.54 1.54 0 0 0-1.044 1.262c-.596 4.477.787 7.795 2.465 9.99a11.777 11.777 0 0 0 2.517 2.453c.386.273.744.482 1.048.625.28.132.581.24.829.24s.548-.108.829-.24a7.159 7.159 0 0 0 1.048-.625 11.775 11.775 0 0 0 2.517-2.453c1.678-2.195 3.061-5.513 2.465-9.99a1.541 1.541 0 0 0-1.044-1.263 62.467 62.467 0 0 0-2.887-.87C9.843.266 8.69 0 8 0zm0 5a1.5 1.5 0 0 1 .5 2.915l.385 1.99a.5.5 0 0 1-.491.595h-.788a.5.5 0 0 1-.49-.595l.384-1.99A1.5 1.5 0 0 1 8 5z"/>
                        </svg>
                    </div>
                    <h2 class="fw-bold" style="color: #0d9488;">First-Time Login</h2>
                    <p class="text-muted fs-5 mt-2">Welcome! You must set a new password before accessing your dashboard.</p>
                </div>
                
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger text-center mb-4 shadow-sm" role="alert">
                        <%= error %>
                    </div>
                <% } %>
                
                <!-- TODO(security): Add CSRF token for production -->
                <form action="/setup-password" method="POST">
                    <div class="mb-4">
                        <label for="new_password" class="form-label text-secondary fw-semibold">New Password</label>
                        <input type="password" class="form-control form-control-lg bg-light border-0 shadow-none" id="new_password" name="new_password" required placeholder="At least 8 characters">
                        <div class="form-text mt-2 text-muted">Password must be at least 8 characters long.</div>
                    </div>
                    <div class="mb-5">
                        <label for="confirm_password" class="form-label text-secondary fw-semibold">Confirm Password</label>
                        <input type="password" class="form-control form-control-lg bg-light border-0 shadow-none" id="confirm_password" name="confirm_password" required placeholder="Type it again">
                    </div>
                    <button type="submit" class="btn btn-lg w-100 rounded-pill fw-bold shadow-sm text-white" style="background-color: #0d9488; transition: transform 0.2s;">
                        Save & Continue
                    </button>
                </form>
            </div>
        </div>
    </div>
</main>

<style>
    .text-shadow { 
        text-shadow: 0 2px 4px rgba(0,0,0,0.5); 
    }
    .form-control:focus {
        border-color: #0d9488 !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 148, 136, 0.25) !important;
    }
    .btn:hover {
        opacity: 0.9;
        transform: translateY(-1px);
    }
</style>
</body>
</html>
