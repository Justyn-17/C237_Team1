<%- include('partials/header') %>

<div class="app-shell">
  <%- include('partials/customer-sidebar', { activePage: 'profile' }) %>

  <main class="app-main">
    <%- include('partials/customer-topbar') %>

    <div class="app-content">

      <div class="page-head">
        <div>
          <h1 class="page-title">My <span class="accent">Profile</span></h1>
          <p class="page-sub">Keep your contact details up to date so the clinic can reach you.</p>
        </div>
      </div>

      <div class="row g-3">

        <!-- Identity card -->
        <div class="col-lg-4">
          <div class="panel h-100">
            <div class="panel-body text-center">
              <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                   style="width: 96px; height: 96px; background: #f0fdfa; color: var(--primary-teal); font-size: 2.5rem;">
                <i class="bi bi-person-fill"></i>
              </div>
              <h5 class="fw-bold mb-1 text-dark"><%= user.name %></h5>
              <div class="text-muted small mb-3">@<%= user.username %></div>
              <span class="chip chip-teal"><i class="bi bi-patch-check-fill"></i> Pet Owner</span>

              <hr class="my-4" style="opacity:.08">

              <div class="text-start">
                <div class="d-flex align-items-center gap-2 mb-2 text-muted small">
                  <i class="bi bi-telephone"></i> <%= user.phone %>
                </div>
                <div class="d-flex align-items-center gap-2 text-muted small">
                  <i class="bi bi-shield-lock"></i> Account active
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Edit form -->
        <div class="col-lg-8">
          <div class="panel mb-3">
            <div class="panel-head">
              <h6 class="panel-title">Account Details</h6>
            </div>
            <div class="panel-body">
              <form action="/profile/update" method="POST">
                <div class="row g-3">
                  <div class="col-md-6">
                    <label for="name" class="form-label-sm d-block">Full Name</label>
                    <div class="input-group">
                      <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-person"></i></span>
                      <input type="text" class="form-control app-input border-start-0" id="name" name="name"
                             value="<%= user.name %>" required>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <label for="phone" class="form-label-sm d-block">Phone Number</label>
                    <div class="input-group">
                      <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-telephone"></i></span>
                      <input type="text" class="form-control app-input border-start-0" id="phone" name="phone"
                             value="<%= user.phone %>" required>
                    </div>
                  </div>
                </div>

                <div class="text-end mt-4">
                  <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                    <i class="bi bi-check2 me-1"></i> Save Changes
                  </button>
                </div>
              </form>
            </div>
          </div>

          <!-- Danger zone -->
          <div class="panel" style="border-color: #fecaca;">
            <div class="panel-head" style="border-bottom-color:#fee2e2;">
              <h6 class="panel-title text-danger">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> Danger Zone
              </h6>
            </div>
            <div class="panel-body d-flex flex-wrap justify-content-between align-items-center gap-3">
              <div>
                <div class="fw-semibold text-dark">Request account deletion</div>
                <div class="text-muted small">Deletion is permanent and cannot be undone once staff approve it.</div>
              </div>

              <!-- TODO(security): Implement CSRF protection for state-changing routes -->
              <form action="/customer/request-deletion" method="POST"
                    onsubmit="return confirm('Are you sure you want to request account deletion? This action cannot be undone.');">
                <button type="submit" class="btn btn-outline-danger rounded-pill px-4 fw-semibold">
                  Request Deletion
                </button>
              </form>
            </div>
          </div>
        </div>

      </div>

    </div>
  </main>
</div>

</body>
</html>
