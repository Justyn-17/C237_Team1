<%- include('partials/header') %>
<!-- Removed the navbar include here so we can achieve a true full-screen split layout -->

<main class="container-fluid p-0 vh-100">
    <div class="row g-0 h-100">
        
        <!-- Left Column: Branding -->
        <div class="col-md-6 col-lg-7 d-none d-md-block position-relative" style="background: linear-gradient(135deg, #0d9488 0%, #042f2e 100%);">
                 
            <!-- Overlay Content -->
            <div class="position-absolute top-50 start-50 translate-middle w-100 text-center text-white px-4">
                <img src="/img/Logo.png" alt="PetWell" class="mb-4" style="max-width:300px;height:auto;border-radius:16px;background:rgba(255,255,255,.9);padding:10px;">
                <h1 class="display-3 fw-bold mb-3 text-shadow">Welcome to PetWell</h1>
                <p class="fs-4 fw-light text-shadow">Providing world-class care for your furry family members.</p>
            </div>
            
            <!-- Convenient Back Button since we removed the navbar -->
            <a href="/" class="position-absolute top-0 start-0 m-4 text-white text-decoration-none fw-semibold fs-5 text-shadow">
                &larr; Back to Home
            </a>
        </div>
        
        <!-- Right Column: Login Form -->
        <div class="col-md-6 col-lg-5 d-flex align-items-center justify-content-center px-4 py-5" style="background-color: #0f172a;">
            <div class="w-100 p-4 p-md-5 rounded-4 shadow-lg" style="max-width: 450px; background-color: #1e293b; border: 1px solid rgba(255, 255, 255, 0.1);">
                
                <!-- Mobile Only Home Link -->
                <a href="/" class="d-md-none text-teal text-decoration-none fw-semibold mb-4 d-inline-block">
                    &larr; Back to Home
                </a>

                <h2 class="text-center mb-5 fw-bold" style="color: var(--primary-teal);">Sign In</h2>
                
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger text-center mb-4" role="alert">
                        <%= error %>
                    </div>
                <% } %>
                
                <% if (typeof successMessage !== 'undefined' && successMessage) { %>
                    <div class="alert alert-success text-center mb-4" role="alert">
                        <%= successMessage %>
                    </div>
                <% } %>
                
                <% const currentTab = (typeof activeTab !== 'undefined' && activeTab) ? activeTab : 'customer'; %>
                <!-- Tabs Navigation -->
                <ul class="nav nav-tabs mb-4 border-0" id="loginTabs" role="tablist">
                    <li class="nav-item w-50 text-center" role="presentation">
                        <!-- Fixed data-bs-target and data-bs-toggle -->
                        <button class="nav-link <%= currentTab === 'customer' ? 'active' : '' %> w-100 fw-bold fs-5" id="customer-tab" data-bs-toggle="tab" data-bs-target="#customer" type="button" role="tab" aria-controls="customer" aria-selected="<%= currentTab === 'customer' ? 'true' : 'false' %>">Customer</button>
                    </li>
                    <li class="nav-item w-50 text-center" role="presentation">
                        <button class="nav-link <%= currentTab === 'staff' ? 'active' : '' %> w-100 fw-bold fs-5" id="staff-tab" data-bs-toggle="tab" data-bs-target="#staff" type="button" role="tab" aria-controls="staff" aria-selected="<%= currentTab === 'staff' ? 'true' : 'false' %>">Staff</button>
                    </li>
                </ul>
                
                <!-- Tabs Content -->
                <div class="tab-content" id="loginTabsContent">
                    
                    <!-- Customer Tab -->
                    <div class="tab-pane fade <%= currentTab === 'customer' ? 'show active' : '' %>" id="customer" role="tabpanel" aria-labelledby="customer-tab">
                        <!-- TODO(security): Add CSRF token for production -->
                        <form action="/login" method="POST">
                            <input type="hidden" name="expectedRole" value="customer">
                            <div class="mb-4">
                                <label for="customer-username" class="form-label text-secondary fw-semibold">Username</label>
                                <input type="text" class="form-control form-control-lg bg-light border-0" id="customer-username" name="username" required placeholder="Enter username">
                            </div>
                            <div class="mb-5">
                                <label for="customer-password" class="form-label text-secondary fw-semibold">Password</label>
                                <input type="password" class="form-control form-control-lg bg-light border-0" id="customer-password" name="password" required placeholder="••••••••">
                            </div>
                            <div class="text-end mb-3">
                                <a href="/forgot-password" class="text-teal text-decoration-none small fw-semibold">Forgot Password?</a>
                            </div>
                            <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold shadow-sm mb-3">Login as Customer</button>
                            
                            <div class="text-center mt-3">
                                <span class="text-muted">Don't have an account?</span> 
                                <a href="/register" class="text-teal text-decoration-none fw-bold">Register here</a>
                            </div>
                        </form>
                    </div>
                    
                    <!-- Staff Tab -->
                    <div class="tab-pane fade <%= currentTab === 'staff' ? 'show active' : '' %>" id="staff" role="tabpanel" aria-labelledby="staff-tab">
                        <!-- TODO(security): Add CSRF token for production -->
                        <form action="/login" method="POST">
                            <input type="hidden" name="expectedRole" value="staff">
                            <div class="mb-4">
                                <label for="staff-username" class="form-label text-secondary fw-semibold">Username</label>
                                <input type="text" class="form-control form-control-lg bg-light border-0" id="staff-username" name="username" required placeholder="Enter username">
                            </div>
                            <div class="mb-5">
                                <label for="staff-password" class="form-label text-secondary fw-semibold">Password</label>
                                <input type="password" class="form-control form-control-lg bg-light border-0" id="staff-password" name="password" required placeholder="••••••••">
                            </div>
                            <div class="text-end mb-3">
                                <a href="/forgot-password" class="text-teal text-decoration-none small fw-semibold">Forgot Password?</a>
                            </div>
                            <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold shadow-sm">Login as Staff</button>
                        </form>
                    </div>
                    
                </div>
                

            </div>
        </div>
    </div>
</main>

<style>
    /* Styling for active tabs to match the teal theme */
    .nav-tabs .nav-link.active {
        color: #2dd4bf !important;
        border-bottom: 3px solid #2dd4bf !important;
        background: transparent !important;
    }
    .nav-tabs .nav-link {
        color: #94a3b8;
        border: none;
        border-bottom: 3px solid transparent;
    }
    .nav-tabs .nav-link:hover {
        border-color: transparent;
        color: #2dd4bf;
    }
    
    .text-shadow {
        text-shadow: 0 2px 4px rgba(0,0,0,0.5);
    }

    /* Dark Mode Form Overrides */
    h2, .text-muted, .text-secondary {
        color: #f8fafc !important;
    }
    .form-control {
        background-color: #0f172a !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        color: #f8fafc !important;
    }
    .form-control::placeholder {
        color: #64748b !important;
    }
    .text-teal {
        color: #2dd4bf !important;
    }
    .bg-light {
        background-color: #0f172a !important;
    }
    .border {
        border-color: rgba(255, 255, 255, 0.1) !important;
    }
</style>

</body>
</html>
