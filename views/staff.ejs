<%- include('partials/header') %>

  <div class="staff-shell">
    <%- include('partials/staff-sidebar', { activePage: 'dashboard' }) %>

      <main class="staff-main">


        <div class="container-fluid p-4">

          <div class="mb-4">
            <h1 class="h3 fw-bold mb-1" style="color: var(--primary-teal);">Global Clinic Dashboard</h1>
            <p class="text-muted mb-0">Overview of clinic activity and quick access to your modules.</p>
          </div>

          <!--
                Key Metrics
                NOTE: the /staff-dashboard route in app.js currently does `res.render('staff')`
                with no data, so totalPets / appointmentsToday aren't defined yet. The fallback
                below shows "—" instead of crashing, and will show real numbers automatically
                as soon as the route passes them (see the optional app.js snippet provided
                separately — not applied here, since app.js isn't being touched).
            -->
          <% const totalPetsCount=typeof totalPets !=='undefined' ? totalPets : null; %>
            <% const apptTodayCount=typeof appointmentsToday !=='undefined' ? appointmentsToday : null; %>

              <div class="row g-4 mb-4">
                <div class="col-md-6 col-lg-3">
                  <div class="card metric-card h-100 border-0 rounded-4 shadow-sm">
                    <div class="card-body d-flex align-items-center gap-3">
                      <div class="metric-icon" style="background-color: #f0fdfa; color: #0d9488;">
                        <i class="bi bi-heart-pulse-fill"></i>
                      </div>
                      <div>
                        <div class="text-muted small">Total Registered Pets (Clinic-Wide)</div>
                        <div class="fs-3 fw-bold text-dark">
                          <%= totalPetsCount !==null ? totalPetsCount : '—' %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="col-md-6 col-lg-3">
                  <div class="card metric-card h-100 border-0 rounded-4 shadow-sm">
                    <div class="card-body d-flex align-items-center gap-3">
                      <div class="metric-icon" style="background-color: #f0fdfa; color: #0d9488;">
                        <i class="bi bi-calendar-check"></i>
                      </div>
                      <div>
                        <div class="text-muted small">Clinic Appointments Today</div>
                        <div class="fs-3 fw-bold text-dark">
                          <%= apptTodayCount !==null ? apptTodayCount : '—' %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Temporary Analytics (mock data placeholders for future ideas) -->
              <div class="row g-4 mb-4">
                <div class="col-lg-7">
                  <div class="card chart-card h-100 border-0 rounded-4 shadow-sm">
                    <div class="card-body">
                      <h6 class="fw-bold mb-3">
                        Clinic-Wide Appointment Volume (All-Time)
                      </h6>
                      <canvas id="monthlyAppointmentsChart"></canvas>
                    </div>
                  </div>
                </div>
                <div class="col-lg-5">
                  <div class="card chart-card h-100 border-0 rounded-4 shadow-sm">
                    <div class="card-body">
                      <h6 class="fw-bold mb-3">
                        Global Pet Demographics
                      </h6>
                      <canvas id="speciesBreakdownChart"></canvas>
                    </div>
                  </div>
                </div>
              </div>

              <!--
                Appointments Table
                Same column layout/styling as views/appointments_index.ejs. The dashboard
                route doesn't pass an `appointments` array yet, so this falls back to an
                empty state with a link to the full /appointments page rather than erroring.
            -->
              <% const apptRows=typeof appointments !=='undefined' ? appointments : []; %>
                <div class="card border-0 rounded-4 shadow-sm">
                  <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                      <h6 class="fw-bold mb-0">Recent Clinic Activity</h6>
                      <a href="/appointments" class="btn btn-sm btn-outline-primary rounded-pill px-3">View All</a>
                    </div>
                    <div class="table-responsive">
                      <table class="table table-striped align-middle mb-0">
                        <thead class="table-light">
                          <tr>
                            <th scope="col">Pet</th>
                            <th scope="col">Owner</th>
                            <th scope="col">Date</th>
                            <th scope="col">Time</th>
                            <th scope="col">Status</th>
                          </tr>
                        </thead>
                        <tbody id="recentActivityBody">
                          <% if (apptRows.length) { %>
                            <% apptRows.forEach(a=> { %>
                              <tr>
                                <td>
                                  <% if (a.pet_name) { %>
                                    <%= a.pet_name %>
                                  <% } else { %>
                                    <span class="text-muted fst-italic">Deleted pet</span>
                                  <% } %>
                                </td>
                                <td>
                                  <%= a.owner_name || '-' %>
                                </td>
                                <td>
                                  <%= a.date && a.date.toISOString ? a.date.toISOString().slice(0, 10) : a.date %>
                                </td>
                                <td>
                                  <%= String(a.start_time || '' ).slice(0, 5) %>
                                </td>
                                <td>
                                  <% if (a.status==='booked' ) { %>
                                    <span class="badge bg-primary">Booked</span>
                                    <% } else if (a.status==='completed' ) { %>
                                      <span class="badge bg-success">Completed</span>
                                      <% } else if (a.status==='cancelled' ) { %>
                                        <span class="badge bg-danger">Cancelled</span>
                                        <% } else { %>
                                          <span class="badge bg-secondary">
                                            <%= a.status %>
                                          </span>
                                          <% } %>
                                </td>
                              </tr>
                              <% }) %>
                                <% } else { %>
                                  <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                      No appointment data passed to this page yet.
                                      <br>
                                      <a href="/appointments" class="btn btn-primary btn-sm mt-2 rounded-pill px-3">
                                        View full appointments list
                                      </a>
                                    </td>
                                  </tr>
                                  <% } %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>

        </div>
      </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
  <script>
    const monthlyAppointments = <%- typeof monthlyAppointments !== 'undefined' ? JSON.stringify(monthlyAppointments).replace(/</g, '\\u003c') : '[]' %>;
    const speciesBreakdown = <%- typeof speciesBreakdown !== 'undefined' ? JSON.stringify(speciesBreakdown).replace(/</g, '\\u003c') : '[]' %>;
    const speciesLabels = speciesBreakdown.map(item => item.label);
    const speciesData = speciesBreakdown.map(item => item.count);
    const palette = ['#0f766e', '#115e59', '#34d399', '#6ee7b7', '#cbd5e1', '#0d9488', '#14b8a6', '#5eead4', '#99f6e4', '#ccfbf1'];
    const speciesColors = speciesBreakdown.map((_, i) => palette[i % palette.length]);

    new Chart(document.getElementById('monthlyAppointmentsChart'), {
      type: 'bar',
      data: {
        labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
        datasets: [{
          label: 'Appointments',
          data: monthlyAppointments,
          backgroundColor: '#0d9488',
          borderRadius: 6
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true } }
      }
    });

    new Chart(document.getElementById('speciesBreakdownChart'), {
      type: 'pie',
      data: {
        labels: speciesLabels,
        datasets: [{
          data: speciesData,
          backgroundColor: speciesColors,
          borderWidth: 2,
          borderColor: '#fff'
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { position: 'bottom', labels: { boxWidth: 20 } }
        }
      }
    });

    function fetchRecentActivity() {
      fetch('/api/recent-activity')
        .then(response => response.json())
        .then(data => {
          const tbody = document.getElementById('recentActivityBody');
          if (!tbody) return;

          if (data.length === 0) {
            tbody.innerHTML = `
              <tr>
                <td colspan="5" class="text-center text-muted py-4">
                  No appointment data passed to this page yet.
                  <br>
                  <a href="/appointments" class="btn btn-primary btn-sm mt-2 rounded-pill px-3">
                    View full appointments list
                  </a>
                </td>
              </tr>
            `;
            return;
          }

          // Names come from user input, so escape them before building the row HTML
          const esc = (v) => String(v).replace(/[&<>"']/g, c => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
          }[c]));

          tbody.innerHTML = data.map(a => {
            // A missing pet_name means the pet record was deleted — show that
            // rather than a raw ID the staff can't do anything with.
            const petDisplay = a.pet_name
              ? esc(a.pet_name)
              : '<span class="text-muted fst-italic">Deleted pet</span>';
            const ownerDisplay = a.owner_name ? esc(a.owner_name) : '-';
            const dateStr = a.date ? (new Date(a.date)).toISOString().slice(0, 10) : a.date;
            const timeStr = a.start_time ? String(a.start_time).slice(0, 5) : '';

            let statusBadge = '';
            if (a.status === 'booked') {
              statusBadge = '<span class="badge bg-primary">Booked</span>';
            } else if (a.status === 'completed') {
              statusBadge = '<span class="badge bg-success">Completed</span>';
            } else if (a.status === 'cancelled') {
              statusBadge = '<span class="badge bg-danger">Cancelled</span>';
            } else {
              statusBadge = `<span class="badge bg-secondary">${a.status}</span>`;
            }

            return `
              <tr>
                <td>${petDisplay}</td>
                <td>${ownerDisplay}</td>
                <td>${dateStr}</td>
                <td>${timeStr}</td>
                <td>${statusBadge}</td>
              </tr>
            `;
          }).join('');
        })
        .catch(err => console.error('Error fetching recent activity:', err));
    }

    setInterval(fetchRecentActivity, 10000);
  </script>

  </body>

  </html>
