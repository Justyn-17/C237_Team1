<%- include('partials/header') %>

  <div class="staff-shell">
    <%- include('partials/staff-sidebar', { activePage: 'dashboard' }) %>

      <main class="staff-main">


        <div class="container-fluid p-4">

          <div class="mb-4">
            <h1 class="h3 fw-bold mb-1" style="color: var(--primary-teal);">Global Clinic Dashboard</h1>
            <p class="text-muted mb-0">Overview of clinic activity and quick access to your modules.</p>
          </div>

          <% if (typeof remainingCodes !== 'undefined' && remainingCodes !== null && remainingCodes <= 2) { %>
            <div class="alert alert-danger d-flex justify-content-between align-items-center shadow-sm" role="alert">
                <div>
                    <strong>Warning:</strong> You have <%= remainingCodes %> master recovery codes remaining. Please generate a new set to avoid losing access to your account.
                </div>
                <form action="/regenerate-recovery-codes" method="POST" class="m-0">
                    <button type="submit" class="btn btn-outline-danger btn-sm fw-bold">
                        Generate New Codes
                    </button>
                </form>
            </div>
          <% } %>

          <!--
                Key Metrics
                NOTE: the /staff-dashboard route in app.js currently does `res.render('staff')`
                with no data, so totalPets / appointmentsToday aren't defined yet. The fallback
                below shows "—" instead of crashing, and will show real numbers automatically
                as soon as the route passes them (see the optional app.js snippet provided
                separately — not applied here, since app.js isn't being touched).
            -->
          <% const totalPetsCount=typeof totalPets !=='undefined' ? totalPets : null; %>
            <% const apptTodayCount=typeof appointmentsToday !=='undefined' ? appointmentsToday : null; %>

              <div class="row g-4 mb-4">
                <div class="col-md-6 col-lg-3">
                  <div class="card metric-card h-100 border-0 rounded-4 shadow-sm">
                    <div class="card-body d-flex align-items-center gap-3">
                      <div class="metric-icon" style="background-color: #f0fdfa; color: #0d9488;">
                        <i class="bi bi-heart-pulse-fill"></i>
                      </div>
                      <div>
                        <div class="text-muted small">Total Registered Pets (Clinic-Wide)</div>
                        <div class="fs-3 fw-bold text-dark">
                          <%= totalPetsCount !==null ? totalPetsCount : '—' %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="col-md-6 col-lg-3">
                  <div class="card metric-card h-100 border-0 rounded-4 shadow-sm">
                    <div class="card-body d-flex align-items-center gap-3">
                      <div class="metric-icon" style="background-color: #f0fdfa; color: #0d9488;">
                        <i class="bi bi-calendar-check"></i>
                      </div>
                      <div>
                        <div class="text-muted small">Clinic Appointments Today</div>
                        <div class="fs-3 fw-bold text-dark">
                          <%= apptTodayCount !==null ? apptTodayCount : '—' %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Temporary Analytics (mock data placeholders for future ideas) -->
              <div class="row g-4 mb-4">
                <div class="col-lg-7">
                  <div class="card chart-card h-100 border-0 rounded-4 shadow-sm">
                    <div class="card-body">
                      <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                        <h6 class="fw-bold mb-0">
                          Clinic-Wide Appointment Volume
                          (<span id="clinicChartTitle">All-Time</span>)
                        </h6>
                        <div class="btn-group btn-group-sm" id="clinicVolumeFilter" role="group" aria-label="Chart timeframe">
                          <button type="button" class="btn btn-outline-teal-chart" data-timeframe="week">Week</button>
                          <button type="button" class="btn btn-outline-teal-chart" data-timeframe="month">Month</button>
                          <button type="button" class="btn btn-outline-teal-chart" data-timeframe="year">Year</button>
                          <button type="button" class="btn btn-outline-teal-chart active" data-timeframe="all-time">All-Time</button>
                        </div>
                      </div>
                      <canvas id="monthlyAppointmentsChart"></canvas>
                    </div>
                  </div>
                </div>
                <div class="col-lg-5">
                  <div class="card chart-card h-100 border-0 rounded-4 shadow-sm">
                    <div class="card-body">
                      <h6 class="fw-bold mb-3">
                        Global Pet Demographics
                      </h6>
                      <canvas id="speciesBreakdownChart"></canvas>
                    </div>
                  </div>
                </div>
              </div>

              <!--
                Appointments Table
                Same column layout/styling as views/appointments_index.ejs. The dashboard
                route doesn't pass an `appointments` array yet, so this falls back to an
                empty state with a link to the full /appointments page rather than erroring.
            -->
              <% const apptRows=typeof appointments !=='undefined' ? appointments : []; %>
                <div class="card border-0 rounded-4 shadow-sm">
                  <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                      <h6 class="fw-bold mb-0">Recent Clinic Activity</h6>
                      <a href="/appointments" class="btn btn-sm btn-outline-primary rounded-pill px-3">View All</a>
                    </div>
                    <div class="table-responsive">
                      <table class="table table-striped align-middle mb-0">
                        <thead class="table-light">
                          <tr>
                            <th scope="col">Pet</th>
                            <th scope="col">Owner</th>
                            <th scope="col">Date</th>
                            <th scope="col">Time</th>
                            <th scope="col">Status</th>
                          </tr>
                        </thead>
                        <tbody id="recentActivityBody">
                          <% if (apptRows.length) { %>
                            <% apptRows.forEach(a=> { %>
                              <tr>
                                <td>
                                  <% if (a.pet_name) { %>
                                    <%= a.pet_name %>
                                  <% } else { %>
                                    <span class="text-muted fst-italic">Deleted pet</span>
                                  <% } %>
                                </td>
                                <td>
                                  <%= a.owner_name || '-' %>
                                </td>
                                <td>
                                  <%= formatDate(a.date) %>
                                </td>
                                <td>
                                  <%= formatTime(a.start_time) %>
                                </td>
                                <td>
                                  <% if (a.status==='booked' ) { %>
                                    <span class="badge bg-primary">Booked</span>
                                    <% } else if (a.status==='completed' ) { %>
                                      <span class="badge bg-success">Completed</span>
                                      <% } else if (a.status==='cancelled' ) { %>
                                        <span class="badge bg-danger">Cancelled</span>
                                        <% } else { %>
                                          <span class="badge bg-secondary">
                                            <%= a.status %>
                                          </span>
                                          <% } %>
                                </td>
                              </tr>
                              <% }) %>
                                <% } else { %>
                                  <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                      No appointment data passed to this page yet.
                                      <br>
                                      <a href="/appointments" class="btn btn-primary btn-sm mt-2 rounded-pill px-3">
                                        View full appointments list
                                      </a>
                                    </td>
                                  </tr>
                                  <% } %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>

        </div>
      </main>
  </div>

  <style>
    .btn-outline-teal-chart {
      color: #0d9488;
      border: 1.5px solid #0d9488;
      background: transparent;
      font-size: 0.78rem;
      font-weight: 600;
      transition: background 0.18s ease, color 0.18s ease;
    }
    .btn-outline-teal-chart:hover {
      background: rgba(13, 148, 136, 0.12);
      color: #0d9488;
    }
    .btn-outline-teal-chart.active {
      background: #0d9488 !important;
      color: #ffffff !important;
      border-color: #0d9488 !important;
    }
  </style>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
  <script>
    const speciesBreakdown = <%- typeof speciesBreakdown !== 'undefined' ? JSON.stringify(speciesBreakdown).replace(/</g, '\\u003c') : '[]' %>;
    const speciesLabels = speciesBreakdown.map(item => item.label);
    const speciesData = speciesBreakdown.map(item => item.count);
    const palette = ['#0f766e', '#115e59', '#34d399', '#6ee7b7', '#cbd5e1', '#0d9488', '#14b8a6', '#5eead4', '#99f6e4', '#ccfbf1'];
    const speciesColors = speciesBreakdown.map((_, i) => palette[i % palette.length]);

    // ── Clinic Volume Chart (dynamic, filter-driven) ──────────────────────────
    // AC1: Tracks the active timeframe so any booking callback can trigger a refresh
    // via: loadClinicVolumeChart(activeClinicTimeframe)
    let activeClinicTimeframe = 'all-time';

    const clinicVolumeChart = new Chart(document.getElementById('monthlyAppointmentsChart'), {
      type: 'bar',
      data: {
        labels: [],
        datasets: [{
          label: 'Appointments',
          data: [],
          backgroundColor: '#0d9488',
          borderRadius: 6
        }]
      },
      options: {
        responsive: true,
        animation: { duration: 400, easing: 'easeInOutQuart' },
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
      }
    });

    const CLINIC_TITLE_LABELS = {
      'week':     'This Week',
      'month':    'This Month',
      'year':     'This Year',
      'all-time': 'All-Time'
    };

    function loadClinicVolumeChart(timeframe) {
      fetch(`/api/appointments/volume?timeframe=${encodeURIComponent(timeframe)}`)
        .then(r => r.ok ? r.json() : Promise.reject(r.status))
        .then(({ labels, data }) => {
          clinicVolumeChart.data.labels = labels;
          clinicVolumeChart.data.datasets[0].data = data;
          clinicVolumeChart.update();
          const titleEl = document.getElementById('clinicChartTitle');
          if (titleEl) titleEl.textContent = CLINIC_TITLE_LABELS[timeframe] || timeframe;
        })
        .catch(err => console.error('Failed to load clinic volume chart:', err));
    }

    // Wire up filter buttons
    document.getElementById('clinicVolumeFilter').addEventListener('click', (e) => {
      const btn = e.target.closest('[data-timeframe]');
      if (!btn) return;
      document.querySelectorAll('#clinicVolumeFilter [data-timeframe]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeClinicTimeframe = btn.dataset.timeframe; // AC1: keep tracking variable in sync
      loadClinicVolumeChart(activeClinicTimeframe);
    });

    // Initialize with All-Time on page load
    loadClinicVolumeChart(activeClinicTimeframe);

    // AC2: Background polling — silently refreshes every 15 s so bookings made by
    // patients or other staff appear without a manual page reload.
    setInterval(() => { loadClinicVolumeChart(activeClinicTimeframe); }, 15000);

    // AC3: Tab-focus sync — re-fetch immediately when the staff member switches
    // back to this dashboard tab after being away.
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) loadClinicVolumeChart(activeClinicTimeframe);
    });
    // ─────────────────────────────────────────────────────────────────────────

    new Chart(document.getElementById('speciesBreakdownChart'), {
      type: 'pie',
      data: {
        labels: speciesLabels,
        datasets: [{
          data: speciesData,
          backgroundColor: speciesColors,
          borderWidth: 2,
          borderColor: '#fff'
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { position: 'bottom', labels: { boxWidth: 20 } }
        }
      }
    });

    function fetchRecentActivity() {
      fetch('/api/recent-activity')
        .then(response => response.json())
        .then(data => {
          const tbody = document.getElementById('recentActivityBody');
          if (!tbody) return;

          if (data.length === 0) {
            tbody.innerHTML = `
              <tr>
                <td colspan="5" class="text-center text-muted py-4">
                  No appointment data passed to this page yet.
                  <br>
                  <a href="/appointments" class="btn btn-primary btn-sm mt-2 rounded-pill px-3">
                    View full appointments list
                  </a>
                </td>
              </tr>
            `;
            return;
          }

          // Names come from user input, so escape them before building the row HTML
          const esc = (v) => String(v).replace(/[&<>"']/g, c => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
          }[c]));

          // Match the server-side formatDate/formatTime output. Uses LOCAL date
          // parts so an ISO string from JSON isn't shifted a day by the timezone.
          const MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
          const fmtDate = (v) => {
            if (!v) return '—';
            const d = new Date(v);
            if (isNaN(d.getTime())) return String(v);
            return `${d.getDate()} ${MON[d.getMonth()]} ${d.getFullYear()}`;
          };
          const fmtTime = (v) => {
            if (!v) return '—';
            const m = String(v).match(/^(\d{1,2}):(\d{2})/);
            if (!m) return String(v);
            let h = parseInt(m[1], 10);
            const ampm = h >= 12 ? 'PM' : 'AM';
            h = h % 12 || 12;
            return `${h}:${m[2]} ${ampm}`;
          };

          tbody.innerHTML = data.map(a => {
            // A missing pet_name means the pet record was deleted — show that
            // rather than a raw ID the staff can't do anything with.
            const petDisplay = a.pet_name
              ? esc(a.pet_name)
              : '<span class="text-muted fst-italic">Deleted pet</span>';
            const ownerDisplay = a.owner_name ? esc(a.owner_name) : '-';
            const dateStr = fmtDate(a.date);
            const timeStr = fmtTime(a.start_time);

            let statusBadge = '';
            if (a.status === 'booked') {
              statusBadge = '<span class="badge bg-primary">Booked</span>';
            } else if (a.status === 'completed') {
              statusBadge = '<span class="badge bg-success">Completed</span>';
            } else if (a.status === 'cancelled') {
              statusBadge = '<span class="badge bg-danger">Cancelled</span>';
            } else {
              statusBadge = `<span class="badge bg-secondary">${a.status}</span>`;
            }

            return `
              <tr>
                <td>${petDisplay}</td>
                <td>${ownerDisplay}</td>
                <td>${dateStr}</td>
                <td>${timeStr}</td>
                <td>${statusBadge}</td>
              </tr>
            `;
          }).join('');
        })
        .catch(err => console.error('Error fetching recent activity:', err));
    }

    setInterval(fetchRecentActivity, 10000);
  </script>

  </body>

  </html>
