<%- include('partials/header') %>

  <div class="staff-shell">
    <%- include('partials/staff-sidebar', { activePage: 'dashboard' }) %>

      <main class="staff-main">


        <div class="container-fluid p-4">

          <div class="mb-4">
            <h1 class="h3 fw-bold mb-1" style="color: var(--primary-teal);">Global Clinic Dashboard</h1>
            <p class="text-muted mb-0">Overview of clinic activity and quick access to your modules.</p>
          </div>

          <% if (typeof remainingCodes !== 'undefined' && remainingCodes !== null && remainingCodes <= 2) { %>
            <div class="alert alert-danger d-flex justify-content-between align-items-center shadow-sm" role="alert">
                <div>
                    <strong>Warning:</strong> You have <%= remainingCodes %> master recovery codes remaining. Please generate a new set to avoid losing access to your account.
                </div>
                <form action="/regenerate-recovery-codes" method="POST" class="m-0">
                    <button type="submit" class="btn btn-outline-danger btn-sm fw-bold">
                        Generate New Codes
                    </button>
                </form>
            </div>
          <% } %>

          <!--
                Key Metrics
                NOTE: the /staff-dashboard route in app.js currently does `res.render('staff')`
                with no data, so totalPets / appointmentsToday aren't defined yet. The fallback
                below shows "—" instead of crashing, and will show real numbers automatically
                as soon as the route passes them (see the optional app.js snippet provided
                separately — not applied here, since app.js isn't being touched).
            -->
          <% const totalPetsCount=typeof totalPets !=='undefined' ? totalPets : null; %>
            <% const apptTodayCount=typeof appointmentsToday !=='undefined' ? appointmentsToday : null; %>
            <%
              const kpiRev   = typeof kpiRevenue        !== 'undefined' ? kpiRevenue        : null;
              const kpiWeek  = typeof kpiWeekAppts      !== 'undefined' ? kpiWeekAppts      : null;
              const kpiPat   = typeof kpiActivePatients !== 'undefined' ? kpiActivePatients : null;
              const kpiVets  = typeof kpiVetsOnDuty     !== 'undefined' ? kpiVetsOnDuty     : null;
            %>

          <!-- ── KPI Ribbon ──────────────────────────────────────────────── -->
          <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
              <div class="card bg-white h-100 border-0 shadow-sm rounded-3">
                <div class="card-body d-flex align-items-center gap-3">
                  <div class="kpi-icon" style="background:rgba(13,148,136,.2);color:#0d9488;">
                    <i class="bi bi-cash-stack"></i>
                  </div>
                  <div>
                    <div class="kpi-label">Revenue (This Month)</div>
                    <div class="kpi-value fw-bold text-dark fs-3" id="kpi-revenue"><%= kpiRev !== null ? '$' + Number(kpiRev).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) : '0' %></div>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="card bg-white h-100 border-0 shadow-sm rounded-3">
                <div class="card-body d-flex align-items-center gap-3">
                  <div class="kpi-icon" style="background:rgba(99,102,241,.2);color:#4f46e5;">
                    <i class="bi bi-calendar-week"></i>
                  </div>
                  <div>
                    <div class="kpi-label">Appointments (This Week)</div>
                    <div class="kpi-value fw-bold text-dark fs-3" id="kpi-week-appts"><%= kpiWeek !== null ? kpiWeek : '0' %></div>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="card bg-white h-100 border-0 shadow-sm rounded-3">
                <div class="card-body d-flex align-items-center gap-3">
                  <div class="kpi-icon" style="background:rgba(245,158,11,.2);color:#d97706;">
                    <i class="bi bi-people-fill"></i>
                  </div>
                  <div>
                    <div class="kpi-label">Active Patients</div>
                    <div class="kpi-value fw-bold text-dark fs-3" id="kpi-active-patients"><%= kpiPat !== null ? kpiPat : '0' %></div>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="card bg-white h-100 border-0 shadow-sm rounded-3">
                <div class="card-body d-flex align-items-center gap-3">
                  <div class="kpi-icon" style="background:rgba(34,197,94,.2);color:#16a34a;">
                    <i class="bi bi-person-badge-fill"></i>
                  </div>
                  <div>
                    <div class="kpi-label">Vets on Duty</div>
                    <div class="kpi-value fw-bold text-dark fs-3" id="kpi-vets"><%= kpiVets !== null ? kpiVets : '0' %></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- ── /KPI Ribbon ─────────────────────────────────────────────── -->

              <div class="row g-4 mb-4">
                <div class="col-md-6 col-lg-3">
                  <div class="card metric-card h-100 border-0 rounded-4 shadow-sm">
                    <div class="card-body d-flex align-items-center gap-3">
                      <div class="metric-icon" style="background-color: #f0fdfa; color: #0d9488;">
                        <i class="bi bi-heart-pulse-fill"></i>
                      </div>
                      <div>
                        <div class="text-muted small">Total Registered Pets (Clinic-Wide)</div>
                        <div class="fs-3 fw-bold text-dark">
                          <%= totalPetsCount !==null ? totalPetsCount : '—' %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="col-md-6 col-lg-3">
                  <div class="card metric-card h-100 border-0 rounded-4 shadow-sm">
                    <div class="card-body d-flex align-items-center gap-3">
                      <div class="metric-icon" style="background-color: #f0fdfa; color: #0d9488;">
                        <i class="bi bi-calendar-check"></i>
                      </div>
                      <div>
                        <div class="text-muted small">Clinic Appointments Today</div>
                        <div class="fs-3 fw-bold text-dark">
                          <%= apptTodayCount !==null ? apptTodayCount : '—' %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Temporary Analytics (mock data placeholders for future ideas) -->
              <div class="row g-4 mb-4">
                <div class="col-lg-7">
                  <div class="card chart-card h-100 border-0 rounded-4 shadow-sm">
                    <div class="card-body">
                      <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                        <h6 class="fw-bold mb-0">
                          Clinic-Wide Appointment Volume
                          (<span id="clinicChartTitle">All-Time</span>)
                        </h6>
                        <div class="btn-group btn-group-sm" id="clinicVolumeFilter" role="group" aria-label="Chart timeframe">
                          <button type="button" class="btn btn-outline-teal-chart" data-timeframe="week">Week</button>
                          <button type="button" class="btn btn-outline-teal-chart" data-timeframe="month">Month</button>
                          <button type="button" class="btn btn-outline-teal-chart" data-timeframe="year">Year</button>
                          <button type="button" class="btn btn-outline-teal-chart active" data-timeframe="all-time">All-Time</button>
                        </div>
                      </div>
                      <canvas id="monthlyAppointmentsChart"></canvas>
                    </div>
                  </div>
                </div>
                <div class="col-lg-5">
                  <div class="card chart-card h-100 border-0 rounded-4 shadow-sm">
                    <div class="card-body">
                      <h6 class="fw-bold mb-3">
                        Global Pet Demographics
                      </h6>
                      <canvas id="speciesBreakdownChart"></canvas>
                    </div>
                  </div>
                </div>
              </div>

              <!-- ── Analytics Row: Revenue Doughnut + Workload Bar ──────────── -->
              <div class="row g-4 mb-4">

                <!-- Revenue by Service Type -->
                <div class="col-lg-6">
                  <div class="card bg-white border-0 shadow-sm rounded-3 h-100">
                    <div class="card-body p-4">
                      <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="analytics-icon" style="background:rgba(13,148,136,.18);color:#0d9488;">
                          <i class="bi bi-pie-chart-fill"></i>
                        </span>
                        <h6 class="fw-bold mb-0 text-dark">Revenue by Service Type</h6>
                      </div>
                      <div id="revenueEmptyState" class="text-center py-4" style="display:none;">
                        <i class="bi bi-receipt text-muted" style="font-size:2rem;"></i>
                        <p class="text-muted mt-2 small">No paid invoices yet.<br>Revenue will appear once payments are processed.</p>
                      </div>
                      <canvas id="revenueDoughnutChart" style="max-height:300px;"></canvas>
                    </div>
                  </div>
                </div>

                <!-- Staff Workload Distribution -->
                <div class="col-lg-6">
                  <div class="card bg-white border-0 shadow-sm rounded-3 h-100">
                    <div class="card-body p-4">
                      <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="analytics-icon" style="background:rgba(13,148,136,.18);color:#0d9488;">
                          <i class="bi bi-bar-chart-fill"></i>
                        </span>
                        <h6 class="fw-bold mb-0 text-dark">Staff Workload Distribution</h6>
                      </div>
                      <div id="workloadEmptyState" class="text-center py-4" style="display:none;">
                        <i class="bi bi-people text-muted" style="font-size:2rem;"></i>
                        <p class="text-muted mt-2 small">No appointment data found.<br>Workload will appear once appointments are booked.</p>
                      </div>
                      <canvas id="workloadBarChart" style="max-height:300px;"></canvas>
                    </div>
                  </div>
                </div>

              </div>

        </div>
      </main>
  </div>

  <style>
    .btn-outline-teal-chart {
      color: #0d9488;
      border: 1.5px solid #0d9488;
      background: transparent;
      font-size: 0.78rem;
      font-weight: 600;
      transition: background 0.18s ease, color 0.18s ease;
    }
    .btn-outline-teal-chart:hover {
      background: rgba(13, 148, 136, 0.12);
      color: #0d9488;
    }
    .btn-outline-teal-chart.active {
      background: #0d9488 !important;
      color: #ffffff !important;
      border-color: #0d9488 !important;
    }
    /* ── KPI Ribbon Cards ─────────────────────────────────────────── */
    .kpi-label {
      font-size: .72rem;
      text-transform: uppercase;
      letter-spacing: .06em;
      color: #64748b;
      font-weight: 600;
    }
    .kpi-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      flex-shrink: 0;
    }
    .analytics-icon {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.05rem;
      flex-shrink: 0;
    }
  </style>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
  <script>
    const speciesBreakdown = <%- typeof speciesBreakdown !== 'undefined' ? JSON.stringify(speciesBreakdown).replace(/</g, '\\u003c') : '[]' %>;
    const speciesLabels = speciesBreakdown.map(item => item.label);
    const speciesData = speciesBreakdown.map(item => item.count);
    const palette = ['#0f766e', '#115e59', '#34d399', '#6ee7b7', '#cbd5e1', '#0d9488', '#14b8a6', '#5eead4', '#99f6e4', '#ccfbf1'];
    const speciesColors = speciesBreakdown.map((_, i) => palette[i % palette.length]);

    // ── Clinic Volume Chart (dynamic, filter-driven) ──────────────────────────
    // AC1: Tracks the active timeframe so any booking callback can trigger a refresh
    // via: loadClinicVolumeChart(activeClinicTimeframe)
    let activeClinicTimeframe = 'all-time';

    const clinicVolumeChart = new Chart(document.getElementById('monthlyAppointmentsChart'), {
      type: 'bar',
      data: {
        labels: [],
        datasets: [{
          label: 'Appointments',
          data: [],
          backgroundColor: '#0d9488',
          borderRadius: 6
        }]
      },
      options: {
        responsive: true,
        animation: { duration: 400, easing: 'easeInOutQuart' },
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
      }
    });

    const CLINIC_TITLE_LABELS = {
      'week':     'This Week',
      'month':    'This Month',
      'year':     'This Year',
      'all-time': 'All-Time'
    };

    function loadClinicVolumeChart(timeframe) {
      fetch(`/api/appointments/volume?timeframe=${encodeURIComponent(timeframe)}`)
        .then(r => r.ok ? r.json() : Promise.reject(r.status))
        .then(({ labels, data }) => {
          clinicVolumeChart.data.labels = labels;
          clinicVolumeChart.data.datasets[0].data = data;
          clinicVolumeChart.update();
          const titleEl = document.getElementById('clinicChartTitle');
          if (titleEl) titleEl.textContent = CLINIC_TITLE_LABELS[timeframe] || timeframe;
        })
        .catch(err => console.error('Failed to load clinic volume chart:', err));
    }

    // Wire up filter buttons
    document.getElementById('clinicVolumeFilter').addEventListener('click', (e) => {
      const btn = e.target.closest('[data-timeframe]');
      if (!btn) return;
      document.querySelectorAll('#clinicVolumeFilter [data-timeframe]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeClinicTimeframe = btn.dataset.timeframe; // AC1: keep tracking variable in sync
      loadClinicVolumeChart(activeClinicTimeframe);
    });

    // Initialize with All-Time on page load
    loadClinicVolumeChart(activeClinicTimeframe);

    // AC2: Background polling — silently refreshes every 15 s so bookings made by
    // patients or other staff appear without a manual page reload.
    setInterval(() => { loadClinicVolumeChart(activeClinicTimeframe); }, 15000);

    // AC3: Tab-focus sync — re-fetch immediately when the staff member switches
    // back to this dashboard tab after being away.
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) loadClinicVolumeChart(activeClinicTimeframe);
    });
    // ─────────────────────────────────────────────────────────────────────────

    new Chart(document.getElementById('speciesBreakdownChart'), {
      type: 'pie',
      data: {
        labels: speciesLabels,
        datasets: [{
          data: speciesData,
          backgroundColor: speciesColors,
          borderWidth: 2,
          borderColor: '#fff'
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: {
            position: 'bottom',
            labels: { boxWidth: 20, color: '#374151' }
          },
          tooltip: {
            backgroundColor: '#ffffff',
            titleColor: '#1e293b',
            bodyColor: '#475569',
            borderColor: '#e2e8f0',
            borderWidth: 1
          }
        }
      }
    });

    // ── Revenue Doughnut Chart ─────────────────────────────────────────────
    let revenueChartInstance = null;
    function loadRevenueChart() {
      const BG_CLR = '#ffffff';
      const LEGEND_CLR = '#374151';
      // Curated light-mode palette
      const PALETTE = [
        '#0d9488', '#14b8a6', '#2dd4bf', '#0ea5e9', '#6366f1',
        '#f59e0b', '#f97316', '#ec4899', '#8b5cf6', '#34d399'
      ];

      const revenueCtx = document.getElementById('revenueDoughnutChart');

      fetch('/api/analytics/revenue')
        .then(r => r.ok ? r.json() : Promise.reject(r.status))
        .then(({ labels, data }) => {
          if (!labels.length) {
            document.getElementById('revenueEmptyState').style.display = '';
            revenueCtx.style.display = 'none';
            return;
          }
          document.getElementById('revenueEmptyState').style.display = 'none';
          revenueCtx.style.display = '';

          if (revenueChartInstance) {
            revenueChartInstance.data.labels = labels;
            revenueChartInstance.data.datasets[0].data = data;
            revenueChartInstance.update();
            return;
          }

          revenueChartInstance = new Chart(revenueCtx, {
            type: 'doughnut',
            data: {
              labels,
              datasets: [{
                data,
                backgroundColor: PALETTE.slice(0, labels.length),
                borderColor: BG_CLR,
                borderWidth: 3,
                hoverOffset: 8
              }]
            },
            options: {
              responsive: true,
              cutout: '62%',
              plugins: {
                legend: {
                  position: 'bottom',
                  labels: { color: LEGEND_CLR, boxWidth: 14, padding: 14, font: { size: 12 } }
                },
                tooltip: {
                  backgroundColor: '#ffffff',
                  titleColor: '#1e293b',
                  bodyColor: '#475569',
                  borderColor: '#e2e8f0',
                  borderWidth: 1,
                  callbacks: {
                    label: (ctx) => ` $${Number(ctx.parsed).toFixed(2)}`
                  }
                }
              }
            }
          });
        })
        .catch(err => console.error('Revenue chart error:', err));
    }
    loadRevenueChart();

    // ── Staff Workload Horizontal Bar Chart ───────────────────────────────
    let workloadChartInstance = null;
    function loadWorkloadChart() {
      const TICK_CLR  = '#475569';
      const GRID_CLR  = 'rgba(0,0,0,0.05)';

      const workloadCtx = document.getElementById('workloadBarChart');

      fetch('/api/analytics/workload')
        .then(r => r.ok ? r.json() : Promise.reject(r.status))
        .then(({ labels, data }) => {
          if (!labels.length) {
            document.getElementById('workloadEmptyState').style.display = '';
            workloadCtx.style.display = 'none';
            return;
          }
          document.getElementById('workloadEmptyState').style.display = 'none';
          workloadCtx.style.display = '';

          if (workloadChartInstance) {
            workloadChartInstance.data.labels = labels;
            workloadChartInstance.data.datasets[0].data = data;
            workloadChartInstance.update();
            return;
          }

          workloadChartInstance = new Chart(workloadCtx, {
            type: 'bar',
            data: {
              labels,
              datasets: [{
                label: 'Appointments',
                data,
                backgroundColor: '#0d9488',
                hoverBackgroundColor: '#14b8a6',
                borderRadius: 6,
                borderSkipped: false
              }]
            },
            options: {
              indexAxis: 'y',
              responsive: true,
              animation: { duration: 500, easing: 'easeInOutQuart' },
              plugins: {
                legend: { display: false },
                tooltip: {
                  backgroundColor: '#ffffff',
                  titleColor: '#1e293b',
                  bodyColor: '#475569',
                  borderColor: '#e2e8f0',
                  borderWidth: 1
                }
              },
              scales: {
                x: {
                  beginAtZero: true,
                  ticks: { color: TICK_CLR, precision: 0 },
                  grid: { color: GRID_CLR }
                },
                y: {
                  ticks: { color: TICK_CLR },
                  grid: { color: GRID_CLR }
                }
              }
            }
          });
        })
        .catch(err => console.error('Workload chart error:', err));
    }
    loadWorkloadChart();

    // ── Real-time Polling for Global Stats ──────────────────────────────────
    function fetchAndRenderKPIs() {
      fetch('/api/analytics/kpis')
        .then(r => {
          if (!r.ok) throw new Error(r.status);
          return r.json();
        })
        .then(data => {
          const revSpan = document.getElementById('kpi-revenue');
          if(revSpan && data.revenue !== undefined) {
             revSpan.textContent = '$' + Number(data.revenue).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
          }
          
          const weekSpan = document.getElementById('kpi-week-appts');
          if(weekSpan && data.weekAppts !== undefined) weekSpan.textContent = data.weekAppts;
          
          const activeSpan = document.getElementById('kpi-active-patients');
          if(activeSpan && data.activePatients !== undefined) activeSpan.textContent = data.activePatients;
          
          const vetsSpan = document.getElementById('kpi-vets');
          if(vetsSpan && data.vetsOnDuty !== undefined) vetsSpan.textContent = data.vetsOnDuty;
        })
        .catch(err => {
            console.error('Failed to fetch KPIs:', err);
            // Abort DOM update on error
            return;
        });
    }

    document.addEventListener('DOMContentLoaded', fetchAndRenderKPIs);

    setInterval(() => {
      fetchAndRenderKPIs();
      loadRevenueChart();
      loadWorkloadChart();
    }, 15000);
    // ──────────────────────────────────────────────────────────────────────

  </script>

  </body>

  </html>
