<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container">
  <div class="row mt-4">
    <div class="col-12">
      <div class="card rounded-4 border-0 shadow-sm">
        <div class="card-body p-5">
          <h1 class="fw-bold text-center mb-5" style="color: var(--primary-teal);">My Pets</h1>

          <% if (pets.length === 0) { %>
            <p class="text-muted text-center">You haven't added any pets yet.</p>
          <% } else { %>
            <div class="table-responsive mb-4">
              <table class="table align-middle">
                <thead>
                  <tr>
                    <th>Photo</th>
                    <th>Name</th>
                    <th>Species</th>
                    <th>Breed</th>
                    <th>Gender</th>
                    <th>Age</th>
                    <th class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% pets.forEach(function(pet) { %>
                    <tr>
                      <td>
                        <img src="<%= photoPath(pet.photo) || 'https://placehold.co/60x60?text=🐾' %>"
                             alt="<%= pet.name %>" class="rounded-circle"
                             style="width: 60px; height: 60px; object-fit: cover;">
                      </td>
                      <td class="fw-bold">🐾 <%= pet.name %></td>
                      <td><%= pet.species %></td>
                      <td><%= pet.breed || 'Unknown' %></td>
                      <td><%= pet.gender %></td>
                      <td><%= pet.age %></td>
                      <td class="text-end">
                        <div class="d-flex gap-2 justify-content-end">
                          <a href="/pets/view/<%= pet.id %>"
                             class="btn btn-info btn-sm text-white fw-semibold">📄 View Records</a>
                          <a href="/pets/edit/<%= pet.id %>"
                             class="btn btn-warning btn-sm text-white fw-semibold">✏️ Edit</a>
                          <form action="/pets/delete/<%= pet.id %>" method="POST"
                                onsubmit="return confirm('Delete <%= pet.name %>?');" class="d-inline">
                            <button type="submit"
                                    class="btn btn-danger btn-sm fw-semibold">🗑️ Delete</button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>

          <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="/addpet"
               class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm px-4">
              ➕ Register New Pet
            </a>

            <a href="/appointments/new"
               class="btn btn-secondary btn-lg rounded-pill fw-bold shadow-sm px-4">
              📅 Book New Appointment
            </a>

            <!-- Student E: Care Reminders -->
            <a href="/reminders"
               class="btn btn-success btn-lg rounded-pill fw-bold shadow-sm px-4">
              🔔 Care Reminders
            </a>
          </div>

        </div>
      </div>
    </div>
  </div>
</main>

</body>
</html>