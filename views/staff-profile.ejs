<%- include('partials/header') %>

<div class="staff-shell">
  <%- include('partials/staff-sidebar', { activePage: 'profile' }) %>

  <main class="staff-main" style="flex: 1; min-width: 0; background-color: #f8fafc;">
    <div class="container-fluid p-4">

      <div class="mb-4">
        <h1 class="h3 fw-bold mb-1" style="color: #0d9488;">My Profile</h1>
        <p class="text-muted mb-0">Keep your contact details up to date so the clinic can reach you.</p>
      </div>

      <div class="row g-4">
        <!-- Identity card -->
        <div class="col-lg-4">
          <div class="card h-100 border-0 shadow-sm rounded-4">
            <div class="card-body text-center p-4">
              <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                   style="width: 96px; height: 96px; background: #f0fdfa; color: #0d9488; font-size: 2.5rem;">
                <i class="bi bi-person-fill"></i>
              </div>
              <h5 class="fw-bold mb-1 text-dark"><%= user.name %></h5>
              <div class="text-muted small mb-3">@<%= user.username %></div>
              
              <span class="badge rounded-pill" style="background: #f0fdfa; color: #0f766e; padding: 0.5rem 1rem; font-weight: 600;">
                <i class="bi bi-patch-check-fill me-1"></i> <%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %>
              </span>

              <hr class="my-4" style="opacity: 0.1">

              <div class="text-start">
                <div class="d-flex align-items-center gap-2 mb-2 text-muted small">
                  <i class="bi bi-telephone text-secondary"></i> <%= user.phone %>
                </div>
                <div class="d-flex align-items-center gap-2 text-muted small">
                  <i class="bi bi-shield-lock text-secondary"></i> Account active
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Edit form -->
        <div class="col-lg-8">
          <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white border-bottom py-3 px-4">
              <h6 class="mb-0 fw-bold text-dark">Account Details</h6>
            </div>
            <div class="card-body p-4">
              <form action="/staff/profile/update" method="POST">
                <div class="row g-3">
                  <div class="col-md-6">
                    <label for="name" class="form-label text-muted small fw-bold text-uppercase" style="letter-spacing: 0.03em;">Full Name</label>
                    <div class="input-group">
                      <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                      <input type="text" class="form-control bg-light border-start-0 ps-0" id="name" name="name"
                             value="<%= user.name %>" required>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <label for="phone" class="form-label text-muted small fw-bold text-uppercase" style="letter-spacing: 0.03em;">Phone Number</label>
                    <div class="input-group">
                      <span class="input-group-text bg-light border-end-0"><i class="bi bi-telephone text-muted"></i></span>
                      <input type="text" class="form-control bg-light border-start-0 ps-0" id="phone" name="phone"
                             value="<%= user.phone %>" required>
                    </div>
                  </div>
                </div>

                <div class="text-end mt-4">
                  <button type="submit" class="btn text-white rounded-pill px-4 shadow-sm" style="background: #0d9488;">
                    <i class="bi bi-check2 me-1"></i> Save Changes
                  </button>
                </div>
              </form>
            </div>
          </div>

          <% if (user && user.role === 'admin') { %>
          <div class="card border-0 shadow-sm rounded-4 mt-4 mb-4">
            <div class="card-body p-4">
              <h5 class="fw-bold text-danger"><i class="bi bi-shield-exclamation me-1"></i> Master Recovery Codes</h5>
              <p class="text-muted">Generate a new batch of 5 Master Recovery Codes. <strong>Warning:</strong> Generating a new set will immediately invalidate all existing unused codes.</p>
              <button type="button" class="btn btn-danger rounded-pill px-4 shadow-sm fw-bold" data-bs-toggle="modal" data-bs-target="#sudoModeModal">Generate New Codes</button>
            </div>
          </div>

          <!-- Sudo Mode Modal -->
          <div class="modal fade" id="sudoModeModal" tabindex="-1" aria-labelledby="sudoModeModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content">
                <form action="/regenerate-recovery-codes" method="POST">
                  <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold" id="sudoModeModalLabel"><i class="bi bi-shield-lock me-2"></i>Verify Your Identity</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>
                  <div class="modal-body p-4">
                    <p class="text-muted mb-4">Please enter your admin password to confirm you want to generate new Master Recovery Codes. <strong>Warning: This invalidates your old codes.</strong></p>
                    <div class="mb-3">
                      <label for="currentPassword" class="form-label fw-bold">Admin Password</label>
                      <input type="password" class="form-control" id="currentPassword" name="currentPassword" required>
                    </div>
                  </div>
                  <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger fw-bold">Verify & Generate Codes</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
          <% } %>
        </div>
      </div>

    </div>
  </main>
</div>

</body>
</html>
