<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container">
    <div class="row justify-content-center mt-4">
        <div class="col-md-8">

            <div class="card shadow rounded-4 border-0">
                <div class="card-body p-5">

                    <h2 class="text-center fw-bold mb-4" style="color: var(--primary-teal);">
                        ✏️ Edit Care Reminder
                    </h2>

                    <form action="/reminders/edit/<%= reminder.id %>" method="POST">

                        <!-- Pet -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Select Pet
                            </label>

                            <select
                                name="pet_id"
                                class="form-select"
                                required>

                                <% pets.forEach(function(pet){ %>

                                    <option
                                        value="<%= pet.id %>"
                                        <%= pet.id == reminder.pet_id ? 'selected' : '' %>>

                                        <%= pet.name %>

                                    </option>

                                <% }) %>

                            </select>
                        </div>

                        <!-- Reminder Title -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Reminder Title
                            </label>

                            <input
                                type="text"
                                name="reminder_title"
                                class="form-control"
                                value="<%= reminder.reminder_title %>"
                                required>
                        </div>

                        <!-- Due Date -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Due Date
                            </label>

                            <input
                                type="date"
                                name="due_date"
                                class="form-control"
                                value="<%= reminder.due_date.toISOString().split('T')[0] %>"
                                required>
                        </div>

                        <!-- Status -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                Status
                            </label>

                            <select
                                name="status"
                                class="form-select">

                                <option
                                    value="Pending"
                                    <%= reminder.status === "Pending" ? "selected" : "" %>>

                                    Pending

                                </option>

                                <option
                                    value="Completed"
                                    <%= reminder.status === "Completed" ? "selected" : "" %>>

                                    Completed

                                </option>

                            </select>
                        </div>

                        <div class="d-flex justify-content-center gap-3">

                            <button
                                type="submit"
                                class="btn btn-warning rounded-pill px-4 fw-bold">

                                💾 Update Reminder

                            </button>

                            <a
                                href="/reminders"
                                class="btn btn-secondary rounded-pill px-4 fw-bold">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</main>

</body>
</html>