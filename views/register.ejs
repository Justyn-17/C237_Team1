<%- include('partials/header') %>

    <main class="container-fluid p-0 vh-100">
        <div class="row g-0 h-100">

            <!-- Left Column: Branding -->
            <div class="col-md-6 col-lg-7 d-none d-md-block position-relative" style="background: linear-gradient(135deg, #0d9488 0%, #042f2e 100%);">

                <!-- Overlay Content -->
                <div class="position-absolute top-50 start-50 translate-middle w-100 text-center text-white px-4">
                    <h1 class="display-3 fw-bold mb-3 text-shadow">Welcome to PetCenter</h1>
                    <p class="fs-4 fw-light text-shadow">Providing world-class care for your furry family members.</p>
                </div>

                <!-- Back Button -->
                <a href="/"
                    class="position-absolute top-0 start-0 m-4 text-white text-decoration-none fw-semibold fs-5 text-shadow">
                    &larr; Back to Home
                </a>
            </div>

            <!-- Right Column: Registration Form -->
            <div class="col-md-6 col-lg-5 bg-white d-flex align-items-center justify-content-center px-4 py-5"
                style="overflow-y: auto;">
                <div class="w-100 py-4" style="max-width: 450px;">

                    <!-- Mobile Only Home Link -->
                    <a href="/" class="d-md-none text-teal text-decoration-none fw-semibold mb-4 d-inline-block">
                        &larr; Back to Home
                    </a>

                    <h2 class="text-center mb-4 fw-bold" style="color: var(--primary-teal);">Customer Registration</h2>

                    <!-- TODO(security): Add CSRF token for production -->
                    <!-- TODO(security): Enforce password validation matching Secure Backend guidelines -->
                    <form action="/register" method="POST">

                        <div class="mb-3">
                            <label for="reg-name" class="form-label text-secondary fw-semibold">Full Name</label>
                            <input type="text" class="form-control form-control-lg bg-light border-0" id="reg-name"
                                name="name" required placeholder="John Doe">
                        </div>

                        <div class="mb-3">
                            <label for="reg-phone" class="form-label text-secondary fw-semibold">Phone Number</label>
                        <input type="tel" class="form-control form-control-lg bg-light border-0" id="reg-phone"
                            name="phone" required>
                        </div>

                        <div class="mb-3">
                            <label for="reg-username" class="form-label text-secondary fw-semibold">Username</label>
                            <input type="text" class="form-control form-control-lg bg-light border-0" id="reg-username"
                                name="username" required placeholder="Choose a username">
                        </div>

                        <div class="mb-3">
                            <label for="reg-password" class="form-label text-secondary fw-semibold">Password</label>
                            <input type="password" class="form-control form-control-lg bg-light border-0"
                                id="reg-password" name="password" minlength="8" required placeholder="••••••••">
                            <div class="form-text mt-1 text-muted"><small>Password must be at least 8
                                    characters.</small></div>
                        </div>

                        <div class="mb-4">
                            <label for="reg-confirm" class="form-label text-secondary fw-semibold">Confirm
                                Password</label>
                            <input type="password" class="form-control form-control-lg bg-light border-0"
                                id="reg-confirm" name="confirm_password" minlength="8" required placeholder="••••••••">
                        </div>

                        <div class="mb-3">
                            <label for="reg-securityQuestion" class="form-label text-secondary fw-semibold">Security Question</label>
                            <select class="form-control form-control-lg bg-light border-0" id="reg-securityQuestion" name="securityQuestion" required>
                                <option value="City you were born in?">City you were born in?</option>
                                <option value="Name of your first pet?">Name of your first pet?</option>
                                <option value="Mother's maiden name?">Mother's maiden name?</option>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label for="reg-securityAnswer" class="form-label text-secondary fw-semibold">Security Answer</label>
                            <input type="text" class="form-control form-control-lg bg-light border-0" id="reg-securityAnswer" name="securityAnswer" required placeholder="Your answer">
                        </div>

                        <button type="submit"
                            class="btn btn-primary btn-lg w-100 rounded-pill fw-bold shadow-sm mb-3">Create
                            Account</button>

                        <div class="text-center mt-3">
                            <span class="text-muted">Already have an account?</span>
                            <a href="/login" class="text-teal text-decoration-none fw-bold">Back to Login</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <style>
        .text-shadow {
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
        }
    </style>

    </body>

    </html>