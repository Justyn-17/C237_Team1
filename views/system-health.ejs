<%- include('partials/header') %>

<div class="staff-shell">
    <%- include('partials/staff-sidebar', { _active: typeof _active !== 'undefined' ? _active : 'system-health' }) %>

    <main class="staff-main">
        <div class="container-fluid p-4">

            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h2 class="fw-bold mb-1" style="color: var(--primary-teal);">
                        <i class="bi bi-activity me-2"></i>System Health & Analytics
                    </h2>
                    <p class="text-muted mb-0">Live platform overview and staff action audit trail.</p>
                </div>
                <span class="badge rounded-pill bg-success px-3 py-2 mt-1" style="font-size:0.8rem;">
                    <i class="bi bi-circle-fill me-1" style="font-size:0.5rem; vertical-align:middle;"></i>
                    Live
                </span>
            </div>

            <!-- Row 1: Stat Cards -->
            <div class="row g-4 mb-4">

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center gap-3 p-4">
                            <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                                 style="width:58px;height:58px;background:rgba(13,110,253,0.10);color:#0d6efd;">
                                <i class="bi bi-people fs-2"></i>
                            </div>
                            <div>
                                <p class="text-muted mb-1 small fw-semibold text-uppercase">Active Customers</p>
                                <div class="display-6 fw-bold lh-1"><%= totalCustomers %></div>
                                <small class="text-muted">excluding deleted accounts</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center gap-3 p-4">
                            <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                                 style="width:58px;height:58px;background:rgba(25,135,84,0.10);color:#198754;">
                                <i class="bi bi-person-badge fs-2"></i>
                            </div>
                            <div>
                                <p class="text-muted mb-1 small fw-semibold text-uppercase">Active Staff</p>
                                <div class="display-6 fw-bold lh-1"><%= totalStaff %></div>
                                <small class="text-muted">staff + admin accounts</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center gap-3 p-4">
                            <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                                 style="width:58px;height:58px;background:rgba(220,53,69,0.10);color:#dc3545;">
                                <i class="bi bi-exclamation-triangle fs-2"></i>
                            </div>
                            <div>
                                <p class="text-muted mb-1 small fw-semibold text-uppercase">Pending Deletions</p>
                                <div class="display-6 fw-bold lh-1"><%= pendingDeletions %></div>
                                <small class="text-muted">awaiting staff approval</small>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Row 2: Audit Log Table -->
            <div class="row">
                <div class="col-12">
                    <div class="card border-0 shadow-sm">

                        <!-- Card Header -->
                        <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="fw-bold mb-1">
                                    <i class="bi bi-shield-lock me-2 text-secondary"></i>System Audit Log
                                </h5>
                                <p class="text-muted small mb-0">
                                    Showing <%= auditLogs ? auditLogs.length : 0 %> of <%= typeof totalLogCount !== 'undefined' ? totalLogCount : 0 %> total entries
                                    <% const _sq = typeof searchQuery !== 'undefined' ? searchQuery : ''; %>
                                    <% const _sa = typeof selectedAction !== 'undefined' ? selectedAction : ''; %>
                                    <% if (_sq || (_sa && _sa !== 'ALL')) { %>
                                        &nbsp;·&nbsp;<span class="text-warning fw-semibold">Filters active</span>
                                    <% } %>
                                </p>
                            </div>
                            <span class="badge bg-secondary rounded-pill px-3 py-2" style="font-size:0.78rem;">
                                Page <%= typeof currentPage !== 'undefined' ? currentPage : 1 %> / <%= typeof totalPages !== 'undefined' ? totalPages : 1 %>
                            </span>
                        </div>

                        <!-- Search & Filter Bar -->
                        <div class="card-body px-4 pt-3 pb-0">
                            <form method="GET" action="/admin/system-health" id="auditFilterForm">
                                <div class="row g-2 align-items-center">

                                    <!-- Search Input -->
                                    <div class="col-md-5">
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0 text-muted">
                                                <i class="bi bi-search"></i>
                                            </span>
                                            <input
                                                type="text"
                                                id="auditSearch"
                                                name="search"
                                                class="form-control border-start-0 bg-light"
                                                placeholder="Search by staff, target user, or date (YYYY-MM-DD)..."
                                                value="<%= searchQuery %>"
                                            >
                                        </div>
                                    </div>

                                    <!-- Action Filter Dropdown -->
                                    <div class="col-md-4">
                                        <select id="auditAction" name="action" class="form-select bg-light">
                                            <option value="ALL"                      <%= (!selectedAction || selectedAction === 'ALL')                       ? 'selected' : '' %>>All Actions</option>
                                            <option value="PASSWORD_RESET"           <%= selectedAction === 'PASSWORD_RESET'            ? 'selected' : '' %>>Password Reset</option>
                                            <option value="DELETION_APPROVED"        <%= selectedAction === 'DELETION_APPROVED'         ? 'selected' : '' %>>Deletion Approved</option>
                                            <option value="DELETION_CANCELLED"       <%= selectedAction === 'DELETION_CANCELLED'        ? 'selected' : '' %>>Deletion Cancelled</option>
                                            <option value="STAFF_ACCOUNT_DELETED"    <%= selectedAction === 'STAFF_ACCOUNT_DELETED'     ? 'selected' : '' %>>Staff Account Deleted</option>
                                            <option value="CUSTOMER_ACCOUNT_DELETED" <%= selectedAction === 'CUSTOMER_ACCOUNT_DELETED'  ? 'selected' : '' %>>Customer Account Deleted</option>
                                        </select>
                                    </div>

                                    <!-- Buttons -->
                                    <div class="col-md-3 d-flex gap-2">
                                        <button type="submit" id="auditFilterBtn" class="btn btn-primary flex-grow-1">
                                            <i class="bi bi-funnel me-1"></i>Filter
                                        </button>
                                        <a href="/admin/system-health" id="auditClearBtn" class="btn btn-outline-secondary flex-grow-1">
                                            <i class="bi bi-x-lg me-1"></i>Clear
                                        </a>
                                    </div>

                                </div>
                            </form>
                        </div>

                        <!-- Table -->
                        <div class="card-body px-4 pb-2 pt-3">
                            <div class="table-responsive">
                                <table class="table table-hover table-borderless align-middle mb-0">
                                    <thead>
                                        <tr style="border-bottom: 2px solid #f0f0f0;">
                                            <th class="text-muted small fw-semibold text-uppercase py-2" style="width:180px;">Date &amp; Time</th>
                                            <th class="text-muted small fw-semibold text-uppercase py-2" style="width:140px;">Actor (Staff)</th>
                                            <th class="text-muted small fw-semibold text-uppercase py-2" style="width:210px;">Action</th>
                                            <th class="text-muted small fw-semibold text-uppercase py-2" style="width:150px;">Target User</th>
                                            <th class="text-muted small fw-semibold text-uppercase py-2">Details / Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (auditLogs && auditLogs.length > 0) { %>
                                            <% auditLogs.forEach(function(log) { %>
                                                <tr style="border-bottom: 1px solid #f8f8f8;">

                                                    <!-- Date & Time -->
                                                    <td class="py-3">
                                                        <%= new Date(log.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                                        <br>
                                                        <small class="text-muted"><%= new Date(log.created_at).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }) %></small>
                                                    </td>

                                                    <!-- Actor -->
                                                    <td class="py-3">
                                                        <span class="d-flex align-items-center gap-2">
                                                            <span class="rounded-circle bg-secondary d-inline-flex align-items-center justify-content-center text-white"
                                                                  style="width:28px;height:28px;font-size:0.7rem;font-weight:700;flex-shrink:0;">
                                                                <%= log.actor ? log.actor.slice(0,2).toUpperCase() : '??' %>
                                                            </span>
                                                            <span class="fw-semibold" style="font-size:0.88rem;"><%= log.actor || '—' %></span>
                                                        </span>
                                                    </td>

                                                    <!-- Action Badge -->
                                                    <td class="py-3">
                                                        <% if (log.action_type === 'PASSWORD_RESET') { %>
                                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill" style="font-size:0.78rem;">
                                                                <i class="bi bi-key me-1"></i>Password Reset
                                                            </span>
                                                        <% } else if (log.action_type === 'DELETION_APPROVED') { %>
                                                            <span class="badge bg-danger px-3 py-2 rounded-pill" style="font-size:0.78rem;">
                                                                <i class="bi bi-trash me-1"></i>Deletion Approved
                                                            </span>
                                                        <% } else if (log.action_type === 'DELETION_CANCELLED') { %>
                                                            <span class="badge bg-info text-dark px-3 py-2 rounded-pill" style="font-size:0.78rem;">
                                                                <i class="bi bi-arrow-counterclockwise me-1"></i>Deletion Cancelled
                                                            </span>
                                                        <% } else if (log.action_type === 'STAFF_ACCOUNT_DELETED') { %>
                                                            <span class="badge bg-dark px-3 py-2 rounded-pill" style="font-size:0.78rem;">
                                                                <i class="bi bi-person-x me-1"></i>Staff Account Deleted
                                                            </span>
                                                        <% } else if (log.action_type === 'CUSTOMER_ACCOUNT_DELETED') { %>
                                                            <span class="badge bg-danger px-3 py-2 rounded-pill" style="font-size:0.78rem;">
                                                                <i class="bi bi-person-x me-1"></i>Customer Account Deleted
                                                            </span>
                                                        <% } else { %>
                                                            <span class="badge bg-secondary px-3 py-2 rounded-pill" style="font-size:0.78rem;">
                                                                <i class="bi bi-question-circle me-1"></i><%= log.action_type %>
                                                            </span>
                                                        <% } %>
                                                    </td>

                                                    <!-- Target User -->
                                                    <td class="py-3">
                                                        <code class="text-dark bg-light px-2 py-1 rounded" style="font-size:0.83rem;">
                                                            <%= log.target_user || '—' %>
                                                        </code>
                                                    </td>

                                                    <!-- Details -->
                                                    <td class="py-3 text-muted" style="font-size:0.85rem;">
                                                        <%= log.details || '—' %>
                                                    </td>

                                                </tr>
                                            <% }); %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="5" class="text-center py-5 text-muted">
                                                    <i class="bi bi-clipboard-x fs-2 d-block mb-2 opacity-25"></i>
                                                    <% if (searchQuery || (selectedAction && selectedAction !== 'ALL')) { %>
                                                        No entries match your current filters.
                                                        <a href="/admin/system-health" class="d-block mt-2">Clear filters</a>
                                                    <% } else { %>
                                                        No audit entries yet. Admin actions (password resets, deletions) will appear here automatically.
                                                    <% } %>
                                                </td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Pagination -->
                        <% if (totalPages > 1) { %>
                        <div class="card-footer bg-white border-0 px-4 pb-4 pt-2">
                            <%
                                // Build base URL preserving search + action params
                                const baseParams = [];
                                if (searchQuery)                              baseParams.push('search=' + encodeURIComponent(searchQuery));
                                if (selectedAction && selectedAction !== 'ALL') baseParams.push('action=' + encodeURIComponent(selectedAction));
                                const baseQS = baseParams.length ? '&' + baseParams.join('&') : '';
                            %>
                            <nav aria-label="Audit log pagination">
                                <ul class="pagination justify-content-center mb-0">

                                    <!-- Previous -->
                                    <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                                        <a class="page-link" href="?page=<%= currentPage - 1 %><%= baseQS %>" aria-label="Previous">
                                            <i class="bi bi-chevron-left"></i>
                                        </a>
                                    </li>

                                    <%
                                        // Show a sliding window of up to 7 pages around currentPage
                                        const paginationRange = 2;
                                        const startPage = Math.max(1, currentPage - paginationRange);
                                        const endPage   = Math.min(totalPages, currentPage + paginationRange);
                                    %>

                                    <% if (startPage > 1) { %>
                                        <li class="page-item">
                                            <a class="page-link" href="?page=1<%= baseQS %>">1</a>
                                        </li>
                                        <% if (startPage > 2) { %>
                                            <li class="page-item disabled"><span class="page-link">…</span></li>
                                        <% } %>
                                    <% } %>

                                    <% for (let p = startPage; p <= endPage; p++) { %>
                                        <li class="page-item <%= p === currentPage ? 'active' : '' %>">
                                            <a class="page-link" href="?page=<%= p %><%= baseQS %>"><%= p %></a>
                                        </li>
                                    <% } %>

                                    <% if (endPage < totalPages) { %>
                                        <% if (endPage < totalPages - 1) { %>
                                            <li class="page-item disabled"><span class="page-link">…</span></li>
                                        <% } %>
                                        <li class="page-item">
                                            <a class="page-link" href="?page=<%= totalPages %><%= baseQS %>"><%= totalPages %></a>
                                        </li>
                                    <% } %>

                                    <!-- Next -->
                                    <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                                        <a class="page-link" href="?page=<%= currentPage + 1 %><%= baseQS %>" aria-label="Next">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>

                                </ul>
                            </nav>
                        </div>
                        <% } %>

                    </div>
                </div>
            </div>

        </div>
    </main>
</div>
