<%- include('partials/header') %>

<div class="app-shell">
  <%- include('partials/customer-sidebar', { activePage: 'dashboard' }) %>

  <main class="app-main">

    <div class="app-content">

      <div class="page-head">
        <div>
          <h1 class="page-title">Edit <span class="accent"><%= pet.name %></span></h1>
          <p class="page-sub">Update your pet's details or replace their photo.</p>
        </div>
        <a href="/customer-dashboard" class="btn btn-outline-secondary rounded-pill px-4">
          <i class="bi bi-arrow-left me-1"></i> Back
        </a>
      </div>

      <form action="/pets/edit/<%= pet.id %>" method="POST" enctype="multipart/form-data">
        <div class="row g-3">

          <div class="col-lg-8">
            <div class="panel mb-3">
              <div class="panel-body">
                <div class="form-section-title">Basic details</div>

                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label-sm d-block">Pet Name</label>
                    <input type="text" name="name" class="form-control app-input" maxlength="50"
                           value="<%= pet.name %>" required>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label-sm d-block">Species</label>
                    <select name="species" id="speciesSelect" class="form-select app-input" required>
                      <option value="">Select Species</option>
                      <option value="Dog" <%= pet.species === 'Dog' ? 'selected' : '' %>>🐕 Dog</option>
                      <option value="Cat" <%= pet.species === 'Cat' ? 'selected' : '' %>>🐈 Cat</option>
                      <option value="Bird" <%= pet.species === 'Bird' ? 'selected' : '' %>>🐦 Bird</option>
                      <option value="Rabbit" <%= pet.species === 'Rabbit' ? 'selected' : '' %>>🐰 Rabbit</option>
                    </select>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label-sm d-block">Breed</label>
                    <select name="breed" id="breedSelect" class="form-select app-input" required>
                      <option value="">Select Breed</option>
                      <% if (pet.breed) { %>
                        <option value="<%= pet.breed %>" selected><%= pet.breed %></option>
                      <% } %>
                    </select>
                  </div>

                  <!-- Custom breed input for "Other" option -->
                  <div class="col-md-6" id="customBreedDiv" style="display: none;">
                    <label class="form-label-sm d-block">Enter Custom Breed</label>
                    <input type="text" name="customBreed" id="customBreedInput"
                           class="form-control app-input" maxlength="50"
                           placeholder="e.g. Mixed Breed, Crossbreed">
                  </div>

                  <div class="col-md-6">
                    <label class="form-label-sm d-block">Gender</label>
                    <select name="gender" class="form-select app-input" required>
                      <option value="Male" <%= pet.gender === 'Male' ? 'selected' : '' %>>Male</option>
                      <option value="Female" <%= pet.gender === 'Female' ? 'selected' : '' %>>Female</option>
                      <option value="Unknown" <%= pet.gender === 'Unknown' ? 'selected' : '' %>>Unknown</option>
                    </select>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label-sm d-block">Age (in years)</label>
                    <input type="number" name="age" step="0.1" class="form-control app-input"
                           min="0" max="50" value="<%= pet.age %>"
                           placeholder="e.g. 2 or 0.5 (for 6 months)" required>
                    <div class="form-text">Use decimals for months: 0.5 = 6 months, 0.25 = 3 months, 0.08 = 1 month</div>
                  </div>
                </div>
              </div>
            </div>

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
              <a href="/customer-dashboard" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
              <button type="submit" class="btn btn-primary btn-lg rounded-pill px-4 fw-bold shadow-sm">
                <i class="bi bi-save me-1"></i> Update Pet
              </button>
            </div>
          </div>

          <div class="col-lg-4">
            <div class="panel">
              <div class="panel-head">
                <h6 class="panel-title">Pet Photo</h6>
              </div>
              <div class="panel-body text-center">
                <img id="photoPreview"
                     src="<%= photoPath(pet.photo) || petPlaceholder %>"
                     alt="<%= pet.name %>" class="rounded-4 mb-3"
                     style="width: 160px; height: 160px; object-fit: cover;">
                <input type="file" name="photo" id="photoInput" accept="image/png, image/jpeg, image/webp"
                       class="form-control app-input">
                <div class="form-text">JPG, PNG, or WEBP, up to 2MB. Leave empty to keep the current photo.</div>
              </div>
            </div>
          </div>

        </div>
      </form>

    </div>
  </main>
</div>

<script>
    const breedOptions = {
        Dog: ['Labrador Retriever', 'Golden Retriever', 'German Shepherd', 'Bulldog', 'Poodle', 'Beagle', 'Husky', 'Dachshund', 'Boxer', 'Corgi'],
        Cat: ['Persian', 'Siamese', 'Maine Coon', 'British Shorthair', 'Bengal', 'Ragdoll', 'Sphynx', 'Scottish Fold', 'Tabby'],
        Bird: ['Parrot', 'Cockatiel', 'Canary', 'Budgie (Parakeet)', 'Lovebird', 'Finch', 'Macaw'],
        Rabbit: ['Holland Lop', 'Dwarf Hotot', 'Dutch Rabbit', 'Angora', 'Rex', 'Mini Lop', 'Lionhead']
    };

    const speciesSelect = document.getElementById('speciesSelect');
    const breedSelect = document.getElementById('breedSelect');
    const customBreedDiv = document.getElementById('customBreedDiv');
    const customBreedInput = document.getElementById('customBreedInput');
    const currentBreed = '<%= pet.breed %>';

    function updateBreedOptions() {
        const selectedSpecies = speciesSelect.value;
        const currentValue = breedSelect.value;

        breedSelect.innerHTML = '<option value="">Select Breed</option>';
        customBreedDiv.style.display = 'none';

        if (selectedSpecies && breedOptions[selectedSpecies]) {
            let breedFound = false;
            breedOptions[selectedSpecies].forEach(breed => {
                const option = document.createElement('option');
                option.value = breed;
                option.textContent = breed;
                if (breed === currentBreed || breed === currentValue) {
                    option.selected = true;
                    breedFound = true;
                }
                breedSelect.appendChild(option);
            });

            // Add "Other" option
            const otherOption = document.createElement('option');
            otherOption.value = 'other';
            otherOption.textContent = '➕ Other (enter custom breed)';
            if (!breedFound && currentBreed && currentBreed !== 'other') {
                otherOption.selected = true;
                customBreedDiv.style.display = 'block';
                customBreedInput.value = currentBreed;
            }
            breedSelect.appendChild(otherOption);
        }
    }

    speciesSelect.addEventListener('change', updateBreedOptions);

    breedSelect.addEventListener('change', function() {
        if (this.value === 'other') {
            customBreedDiv.style.display = 'block';
            customBreedInput.setAttribute('required', 'required');
            customBreedInput.focus();
        } else {
            customBreedDiv.style.display = 'none';
            customBreedInput.removeAttribute('required');
            customBreedInput.value = '';
        }
    });

    // Live preview of a newly chosen photo
    const photoInput = document.getElementById('photoInput');
    photoInput.addEventListener('change', function() {
        const file = this.files && this.files[0];
        if (file) {
            document.getElementById('photoPreview').src = URL.createObjectURL(file);
        }
    });

    // Form submission validation
    document.querySelector('form').addEventListener('submit', function(e) {
        if (breedSelect.value === 'other' && !customBreedInput.value.trim()) {
            e.preventDefault();
            alert('Please enter a custom breed or select one from the list.');
            customBreedInput.focus();
            return false;
        }
    });

    // Initialize on page load
    updateBreedOptions();
</script>

</body>
</html>
