<%- include('partials/header') %>

<style>
    /* Full Viewport Override */
    body, html {
        margin: 0;
        padding: 0;
        height: 100%;
        min-height: 100vh;
    }
    
    /* Ensure no parent containers restrict height if injected into a global layout */
    #layout-wrapper, .wrapper, main, body > div {
        height: 100%;
        min-height: 100vh;
    }

    /* Left Side: Deep Teal Gradient with Pattern */
    .recovery-left-panel {
        background: linear-gradient(135deg, #0f766e 0%, #042f2e 100%);
        position: relative;
        color: white;
    }

    /* Subtle Grid Background Pattern */
    .recovery-left-panel::before {
        content: "";
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background-image: 
            linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
        background-size: 40px 40px;
        pointer-events: none;
    }

    .recovery-card {
        width: 100%;
        max-width: 480px;
    }

    /* Form Components */
    .teal-btn {
        background-color: #0f766e;
        color: white;
        border: none;
        transition: background-color 0.2s;
    }

    .teal-btn:hover {
        background-color: #0d9488;
        color: white;
    }

    .teal-icon {
        color: #0f766e;
    }

    .minimal-input {
        border: 1px solid #dee2e6;
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
    }
    
    .minimal-input:focus {
        border-color: #0f766e;
        box-shadow: 0 0 0 0.25rem rgba(15, 118, 110, 0.25);
    }
</style>

<div class="container-fluid p-0 min-vh-100" style="min-height: 100vh !important;">
    <div class="row g-0 min-vh-100" style="min-height: 100vh !important;">
        
        <!-- Left Side: Information Panel -->
        <div class="col-md-6 col-lg-6 recovery-left-panel d-flex flex-column justify-content-center align-items-center p-4 p-md-5">
            <div class="position-relative z-1 text-center w-100" style="max-width: 85%;">
                <h1 class="display-5 fw-bold mb-3 text-shadow">Set New Password</h1>
                <h2 class="h5 fw-normal mb-4 text-white-50 lh-base">Secure your Admin Account</h2>
                <p class="text-white-50 m-0">Please enter a strong, permanent password to regain access to your dashboard.</p>
            </div>
        </div>
        
        <!-- Right Side: Form Panel -->
        <div class="col-md-6 col-lg-6 bg-light d-flex flex-column justify-content-center align-items-center p-4 p-md-5">
            <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 recovery-card">
                
                <!-- Card Header Elements -->
                <div class="text-center mb-4">
                    <!-- Shield with keyhole SVG -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="currentColor" class="bi bi-shield-lock-fill teal-icon mb-3" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M8 0c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87a1.54 1.54 0 0 0-1.044 1.262c-.596 4.477.787 7.795 2.465 9.99a11.777 11.777 0 0 0 2.517 2.453c.386.273.744.482 1.048.625.28.132.581.24.829.24s.548-.108.829-.24a7.159 7.159 0 0 0 1.048-.625 11.775 11.775 0 0 0 2.517-2.453c1.678-2.195 3.061-5.513 2.465-9.99a1.541 1.541 0 0 0-1.044-1.263 62.467 62.467 0 0 0-2.887-.87C9.843.266 8.69 0 8 0zm0 5a1.5 1.5 0 0 1 .5 2.915l.385 1.99a.5.5 0 0 1-.491.595h-.788a.5.5 0 0 1-.49-.595l.384-1.99A1.5 1.5 0 0 1 8 5z"/>
                    </svg>
                    <h2 class="h4 fw-bold text-dark mb-1">Create New Password</h2>
                    <p class="text-muted mb-0">Admin Account Recovery</p>
                </div>
                
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger text-center" role="alert">
                        <%= error %>
                    </div>
                <% } %>
                
                <form action="/reset-password" method="POST">
                    <div class="mb-4">
                        <label for="newPassword" class="form-label fw-semibold text-secondary small text-uppercase tracking-wider">New Password</label>
                        <input type="password" class="form-control minimal-input" id="newPassword" name="newPassword" minlength="8" required>
                    </div>
                    
                    <div class="mb-5">
                        <label for="confirmPassword" class="form-label fw-semibold text-secondary small text-uppercase tracking-wider">Confirm New Password</label>
                        <input type="password" class="form-control minimal-input" id="confirmPassword" name="confirmPassword" minlength="8" required>
                    </div>
                    
                    <button type="submit" class="btn teal-btn py-3 w-100 rounded-pill fw-bold shadow-sm">Save New Password & Login</button>
                </form>
                
            </div>
        </div>
        
    </div>
</div>
