<%- include('partials/header') %>
  <%- include('partials/navbar') %>

    <style>
      :root {
        --primary-teal: #0d9488;
        --primary-teal-light: #2dd4bf;
        --primary-teal-dark: #115e59;
        --dark-slate: #0f172a;
        --slate-card: #1e293b;
      }

      /* Remove Navbar Bottom Margin for Flush Hero Integration */
      .navbar {
        margin-bottom: 0 !important;
      }

      /* Smooth anchor scrolling */
      html {
        scroll-behavior: smooth;
      }

      /* Premium Dark Slate & Teal Radial Mesh Hero */
      .hero-section {
        background:
          radial-gradient(circle at 85% 15%, rgba(13, 148, 136, 0.28) 0%, transparent 45%),
          radial-gradient(circle at 15% 85%, rgba(15, 23, 42, 0.95) 0%, transparent 50%),
          linear-gradient(135deg, #0f172a 0%, #1e293b 55%, #0d9488 100%);
        min-height: calc(100vh - 70px);
        width: 100%;
        padding-top: 80px;
        padding-bottom: 80px;
        margin: 0 !important;
        border-radius: 0 !important;
        position: relative;
        overflow: hidden;
      }

      .hero-container-constrained {
        max-width: 1440px;
        margin: 0 auto;
      }

      .text-teal-gradient {
        background: linear-gradient(135deg, #2dd4bf 0%, #38bdf8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .hero-badge-glow {
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(45, 212, 191, 0.3);
        color: #e2e8f0;
        font-size: 0.88rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
      }

      .pulse-dot {
        width: 8px;
        height: 8px;
        background-color: #2dd4bf;
        border-radius: 50%;
        display: inline-block;
        box-shadow: 0 0 10px #2dd4bf;
        animation: pulseGlow 2s infinite ease-in-out;
      }

      @keyframes pulseGlow {

        0%,
        100% {
          transform: scale(1);
          opacity: 1;
        }

        50% {
          transform: scale(1.4);
          opacity: 0.6;
        }
      }

      .hero-feature-tag {
        background: rgba(255, 255, 255, 0.06);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #cbd5e1;
        font-size: 0.88rem;
        font-weight: 500;
        padding: 6px 14px;
        border-radius: 50rem;
        display: inline-flex;
        align-items: center;
      }

      .btn-hero-primary {
        background: linear-gradient(135deg, #0d9488 0%, #14b8a6 100%);
        color: #ffffff !important;
        border: none;
        transition: all 0.3s ease;
        box-shadow: 0 10px 25px rgba(13, 148, 136, 0.35);
      }

      .btn-hero-primary:hover {
        background: linear-gradient(135deg, #0f766e 0%, #0d9488 100%);
        color: #ffffff !important;
        transform: translateY(-2px);
        box-shadow: 0 15px 30px rgba(13, 148, 136, 0.5);
      }

      .btn-hero-secondary {
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(12px);
        color: #ffffff !important;
        border: 1px solid rgba(255, 255, 255, 0.2);
        transition: all 0.3s ease;
      }

      .btn-hero-secondary:hover {
        background: rgba(255, 255, 255, 0.18);
        border-color: rgba(255, 255, 255, 0.4);
        color: #ffffff !important;
        transform: translateY(-2px);
      }

      .hero-media-wrapper {
        position: relative;
        border-radius: 1.75rem;
        overflow: hidden;
        background: var(--dark-slate);
        border: 1px solid rgba(255, 255, 255, 0.15);
        box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.6);
        width: 100%;
        height: 100%;
      }

      .hero-media-wrapper img {
        width: 100%;
        height: 100%;
        min-height: 360px;
        max-height: 520px;
        object-fit: cover;
        display: block;
        transition: transform 0.6s ease;
      }

      .hero-media-wrapper:hover img {
        transform: scale(1.04);
      }

      .glass-card-overlay {
        position: absolute;
        background: rgba(15, 23, 42, 0.82);
        backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: white;
        padding: 12px 20px;
        border-radius: 1.25rem;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
      }

      .glass-card-top-right {
        top: 20px;
        right: 20px;
      }

      .glass-card-bottom-left {
        bottom: 20px;
        left: 20px;
      }



      /* Morphing Hover Gallery */
      .services-gallery {
        display: flex;
        gap: 12px;
        height: 420px;
        width: 100%;
      }

      .service-card {
        flex: 0.6;
        min-width: 80px;
        position: relative;
        overflow: hidden;
        border-radius: 1.25rem;
        cursor: pointer;
        transition: flex 0.5s cubic-bezier(0.25, 1, 0.5, 1), transform 0.3s ease, box-shadow 0.3s ease;
        color: white;
        text-decoration: none;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08);
        background-size: cover !important;
        background-position: center !important;
      }

      .service-card:hover {
        flex: 4.5;
        box-shadow: 0 20px 35px rgba(13, 148, 136, 0.3);
      }

      /* Card Background Images with Overlays */
      .service-card-1 {
        background: 
          linear-gradient(180deg, rgba(15, 23, 42, 0.55) 0%, rgba(13, 148, 136, 0.88) 100%),
          url('/uploads/image/general-checkup.jpg');
      }

      .service-card-2 {
        background: 
          linear-gradient(180deg, rgba(15, 23, 42, 0.55) 0%, rgba(17, 94, 89, 0.88) 100%),
          url('/uploads/image/vaccination.jpg');
      }

      .service-card-3 {
        background: 
          linear-gradient(180deg, rgba(15, 23, 42, 0.6) 0%, rgba(15, 118, 110, 0.88) 100%),
          url('/uploads/image/surgery.jpg');
      }

      .service-card-4 {
        background: 
          linear-gradient(180deg, rgba(15, 23, 42, 0.55) 0%, rgba(13, 148, 136, 0.88) 100%),
          url('/uploads/image/grooming.jpg');
      }

      .service-card-inner {
        height: 100%;
        width: 100%;
        padding: 1.75rem 1.25rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        z-index: 2;
      }

      .service-icon-wrapper {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.18);
        backdrop-filter: blur(6px);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        margin-bottom: 1rem;
        flex-shrink: 0;
      }

      .service-collapsed-title {
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        white-space: nowrap;
        font-size: 1.15rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        margin-top: auto;
        transition: opacity 0.3s ease;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
      }

      .service-card:hover .service-collapsed-title {
        opacity: 0;
        display: none;
      }

      .service-expanded-content {
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.4s ease 0.15s, visibility 0.4s ease 0.15s;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        height: 100%;
      }

      .service-card:hover .service-expanded-content {
        opacity: 1;
        visibility: visible;
      }

      .service-title {
        font-size: 1.6rem;
        font-weight: 700;
        margin-bottom: 0.75rem;
      }

      .service-description {
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.9);
        line-height: 1.5;
        margin-bottom: 1.25rem;
        max-width: 340px;
      }

      /* Responsive layout for mobile screens */
      @media (max-width: 768px) {
        .hero-section {
          min-height: auto;
          padding-top: 50px;
          padding-bottom: 50px;
        }

        .hero-media-wrapper img {
          min-height: 280px;
          max-height: 340px;
        }

        .glass-card-top-right {
          top: 10px;
          right: 10px;
          padding: 8px 14px;
          font-size: 0.8rem;
        }

        .glass-card-bottom-left {
          bottom: 10px;
          left: 10px;
          padding: 8px 14px;
          font-size: 0.8rem;
        }

        .services-gallery {
          flex-direction: column;
          height: auto;
        }

        .service-card {
          height: 140px;
          flex: none !important;
          transition: height 0.5s ease-in-out;
        }

        .service-card:hover {
          height: 260px;
        }

        .service-collapsed-title {
          writing-mode: horizontal-tb;
          transform: none;
          margin-top: 0;
        }
      }

      /* Smooth FAQ accordion slide transition */
      .accordion-collapse {
        transition: height 0.4s ease-in-out;
      }

      /* Teal outline button for news cards */
      .btn-outline-teal {
        color: #0d9488;
        border: 1.5px solid #0d9488;
        background: transparent;
        font-weight: 600;
        border-radius: 50rem;
        font-size: 0.82rem;
        transition: background 0.2s ease, color 0.2s ease;
      }
      .btn-outline-teal:hover {
        background: #0d9488;
        color: #ffffff;
      }

      /* FAQ Nav-Pill tab active/hover states */
      #faqTabs .nav-link {
        color: #475569;
        border: 1.5px solid transparent;
        transition: all 0.2s ease;
      }
      #faqTabs .nav-link:hover:not(.active) {
        color: #0d9488;
        border-color: rgba(13,148,136,0.3);
        background: rgba(13,148,136,0.08);
      }
      #faqTabs .nav-link.active {
        background: #0d9488 !important;
        color: #ffffff !important;
        box-shadow: 0 4px 15px rgba(13,148,136,0.35);
      }

      /* AC5: Centered Scroll Alignment */
      #services, #news, #resources, #faq {
        scroll-margin-top: 15vh;
      }

      /* AC2: Dark Theme FAQ Cards */
      #faq .accordion-item {
        background: #1e293b !important;
        border: 1px solid rgba(255, 255, 255, 0.12) !important;
        border-radius: 0.75rem !important;
        margin-bottom: 0.75rem !important;
      }
      #faq .accordion-button {
        background: transparent !important;
        color: #f8fafc !important;
      }
      #faq .accordion-button:not(.collapsed) {
        background: #0d9488 !important;
        color: #ffffff !important;
      }
      #faq .accordion-button::after {
        filter: invert(1);
      }
      #faq .accordion-body {
        background: transparent !important;
        color: #f8fafc !important;
      }
    </style>

    <main class="w-100 p-0">
      <!-- Premium Glassmorphism & Mesh Gradient Hero Section -->
      <section class="hero-section d-flex align-items-center">
        <div class="container-fluid px-4 px-lg-5 hero-container-constrained">
          <div class="row align-items-center g-4 g-lg-5 w-100 mx-0">
            <!-- Left Text Column -->
            <div class="col-12 col-lg-6 mb-4 mb-lg-0">
              <div class="hero-badge-glow mb-3 d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill">
                <span class="pulse-dot"></span>
                <span>🐾 Premier Pet Healthcare & Wellness Clinic</span>
              </div>

              <h1 class="fw-bold text-white mb-3"
                style="font-size: clamp(2.2rem, 3.8vw, 4.5rem); line-height: 1.15; letter-spacing: -0.5px;">
                World-Class Care For Your <span class="text-teal-gradient">Furry Family</span>
              </h1>

              <p class="lead mb-4"
                style="color: #94a3b8; font-size: clamp(1rem, 1.25vw, 1.2rem); max-width: 580px; line-height: 1.6;">
                From preventive wellness and immunizations to advanced surgical procedures and luxury grooming, our
                certified veterinary team delivers compassionate, top-tier medical care.
              </p>

              <!-- Feature Pills -->
              <div class="d-flex flex-wrap gap-2 mb-4">
                <span class="hero-feature-tag">🩺 Certified Vet Specialists</span>
                <span class="hero-feature-tag">⚡ 24/7 Emergency Care</span>
                <span class="hero-feature-tag">❤ 5,000+ Happy Patients</span>
              </div>

              <!-- CTA Action Buttons -->
              <div class="d-flex flex-wrap gap-3">
                <a href="/appointments/new" class="btn btn-hero-primary btn-lg rounded-pill px-4 py-3 fw-bold">
                  Book an Appointment
                </a>
                <a href="#services" class="btn btn-hero-secondary btn-lg rounded-pill px-4 py-3 fw-bold">
                  Explore Services
                </a>
              </div>
            </div>

            <!-- Right Visual Media Column with Floating Glass Cards -->
            <div class="col-12 col-lg-6 d-flex align-items-center">
              <div class="hero-media-wrapper w-100">
                <!-- Bootstrap 5 Fade Carousel - Hero Pet Slideshow -->
                <div id="heroPetCarousel" class="carousel slide carousel-fade shadow-lg"
                     data-bs-ride="carousel" data-bs-interval="3500">
                  <div class="carousel-inner" style="border-radius: 1.5rem; overflow: hidden;">
                    <div class="carousel-item active">
                      <img src="https://images.unsplash.com/photo-1543466835-00a7907e9de1?auto=format&fit=crop&w=1000&q=80"
                           alt="Happy dog at PetWell clinic"
                           style="object-fit: cover; width: 100%; height: 100%; min-height: 40vh; max-height: 70vh; border-radius: 1.5rem;">
                    </div>
                    <div class="carousel-item">
                      <img src="https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?auto=format&fit=crop&w=1000&q=80"
                           alt="Cat receiving care at PetWell"
                           style="object-fit: cover; width: 100%; height: 100%; min-height: 40vh; max-height: 70vh; border-radius: 1.5rem;">
                    </div>
                    <div class="carousel-item">
                      <img src="https://images.unsplash.com/photo-1552053831-71594a27632d?auto=format&fit=crop&w=1000&q=80"
                           alt="Golden Retriever at PetWell"
                           style="object-fit: cover; width: 100%; height: 100%; min-height: 40vh; max-height: 70vh; border-radius: 1.5rem;">
                    </div>
                    <div class="carousel-item">
                      <img src="https://images.unsplash.com/photo-1585110396000-c9ffd4e4b308?auto=format&fit=crop&w=1000&q=80"
                           alt="Rabbit at PetWell"
                           style="object-fit: cover; width: 100%; height: 100%; min-height: 40vh; max-height: 70vh; border-radius: 1.5rem;">
                    </div>
                    <div class="carousel-item">
                      <img src="https://images.unsplash.com/photo-1425082661705-1834bfd09dca?auto=format&fit=crop&w=1000&q=80"
                           alt="Guinea Pig at PetWell"
                           style="object-fit: cover; width: 100%; height: 100%; min-height: 40vh; max-height: 70vh; border-radius: 1.5rem;">
                    </div>
                    <div class="carousel-item">
                      <img src="https://images.unsplash.com/photo-1552728089-57bdde30beb3?auto=format&fit=crop&w=1000&q=80"
                           alt="Bird at PetWell"
                           style="object-fit: cover; width: 100%; height: 100%; min-height: 40vh; max-height: 70vh; border-radius: 1.5rem;">
                    </div>
                  </div>
                  <!-- Carousel indicators -->
                  <div class="carousel-indicators" style="bottom: -28px;">
                    <button type="button" data-bs-target="#heroPetCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1" style="background-color:#2dd4bf;"></button>
                    <button type="button" data-bs-target="#heroPetCarousel" data-bs-slide-to="1" aria-label="Slide 2" style="background-color:#2dd4bf;"></button>
                    <button type="button" data-bs-target="#heroPetCarousel" data-bs-slide-to="2" aria-label="Slide 3" style="background-color:#2dd4bf;"></button>
                    <button type="button" data-bs-target="#heroPetCarousel" data-bs-slide-to="3" aria-label="Slide 4" style="background-color:#2dd4bf;"></button>
                    <button type="button" data-bs-target="#heroPetCarousel" data-bs-slide-to="4" aria-label="Slide 5" style="background-color:#2dd4bf;"></button>
                  </div>
                </div>

                <!-- Floating Top Right Rating Card -->
                <div class="glass-card-overlay glass-card-top-right d-flex align-items-center gap-2">
                  <span style="color: #fbbf24; font-size: 1.1rem;">★</span>
                  <div>
                    <div class="fw-bold" style="font-size: 0.9rem; line-height: 1;">4.9 / 5.0 Rating</div>
                    <small style="color: #94a3b8; font-size: 0.75rem;">Verified Pet Parents</small>
                  </div>
                </div>

                <!-- Floating Bottom Left Badge Card -->
                <div class="glass-card-overlay glass-card-bottom-left d-flex align-items-center gap-2">
                  <span style="color: #2dd4bf; font-size: 1.2rem;">🏥</span>
                  <div>
                    <div class="fw-bold" style="font-size: 0.9rem; line-height: 1;">Modern Surgical Suite</div>
                    <small style="color: #94a3b8; font-size: 0.72rem;">24/7 Dedicated Emergency Care</small>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Full-Width Services Section -->
      <section id="services" class="services-section pb-5" style="background-color: #09262a; border-top: 1px solid rgba(255, 255, 255, 0.15);">
        <div class="container pt-5">
          <div class="text-center mb-5">
            <h2 class="fw-bold display-6" style="color: #f8fafc;">Our Services</h2>
            <p style="color: #94a3b8;" class="fs-6">Explore our specialized clinic offerings and comprehensive treatments</p>
          </div>
          <div class="services-gallery">
            <!-- Service Card 1 -->
            <div class="service-card service-card-1">
              <div class="service-card-inner">
                <div>
                  <div class="service-icon-wrapper">🩺</div>
                  <div class="service-collapsed-title">General Checkup</div>
                </div>
                <div class="service-expanded-content">
                  <div>
                    <h3 class="service-title">General Checkup</h3>
                    <p class="service-description">Comprehensive physical examinations, bloodwork diagnostics, and
                      personalized health consultations to keep your pet in peak health.</p>
                  </div>
                  <div>
                    <a href="/services#checkup"
                      class="btn btn-light rounded-pill px-4 py-2 text-dark fw-semibold shadow-sm">Learn More</a>
                  </div>
                </div>
              </div>
            </div>

            <!-- Service Card 2 -->
            <div class="service-card service-card-2">
              <div class="service-card-inner">
                <div>
                  <div class="service-icon-wrapper">💉</div>
                  <div class="service-collapsed-title">Vaccinations</div>
                </div>
                <div class="service-expanded-content">
                  <div>
                    <h3 class="service-title">Vaccinations</h3>
                    <p class="service-description">Essential immunization schedules and flea/tick protection tailored
                      specifically to your pet's breed, age, and lifestyle.</p>
                  </div>
                  <div>
                    <a href="/services#vaccinations"
                      class="btn btn-light rounded-pill px-4 py-2 text-dark fw-semibold shadow-sm">Learn More</a>
                  </div>
                </div>
              </div>
            </div>

            <!-- Service Card 3 -->
            <div class="service-card service-card-3">
              <div class="service-card-inner">
                <div>
                  <div class="service-icon-wrapper">🏥</div>
                  <div class="service-collapsed-title">Surgery</div>
                </div>
                <div class="service-expanded-content">
                  <div>
                    <h3 class="service-title">Surgery & Care</h3>
                    <p class="service-description">Advanced surgical suite equipped for routine spay/neuter operations,
                      soft tissue procedures, and emergency surgical care.</p>
                  </div>
                  <div>
                    <a href="/services#surgery"
                      class="btn btn-light rounded-pill px-4 py-2 text-dark fw-semibold shadow-sm">Learn More</a>
                  </div>
                </div>
              </div>
            </div>

            <!-- Service Card 4 -->
            <div class="service-card service-card-4">
              <div class="service-card-inner">
                <div>
                  <div class="service-icon-wrapper">✂️</div>
                  <div class="service-collapsed-title">Grooming</div>
                </div>
                <div class="service-expanded-content">
                  <div>
                    <h3 class="service-title">Pet Grooming</h3>
