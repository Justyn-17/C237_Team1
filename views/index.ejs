                  <div>
                    <a href="/services#grooming"
                      class="btn btn-light rounded-pill px-4 py-2 text-dark fw-semibold shadow-sm">Learn More</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ===================================================== -->
      <!-- Latest Pet News Section                                -->
      <!-- ===================================================== -->
      <section id="news" class="pb-5" style="background-color: #111827; border-top: 1px solid rgba(255, 255, 255, 0.15);">
        <div class="container-xl px-4 pt-5">
          <div class="text-center mb-5">
            <h2 class="fw-bold display-6" style="color: #f8fafc;">Latest Pet News</h2>
            <p style="color: #94a3b8;" class="fs-6">Stay informed with the latest updates from the local pet care community</p>
          </div>
          <div class="row g-4" style="flex-wrap: nowrap;">

            <!-- News Card 1 -->
            <div class="col-4">
              <div class="card h-100 shadow-sm rounded-4 border-0" style="border-top: 4px solid #2dd4bf !important; background: #0f172a;">
                <div class="card-body p-4 d-flex flex-column">
                  <div class="mb-3">
                    <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background: rgba(45,212,191,0.15); color: #2dd4bf; font-size: 0.78rem;">🏠 Housing Policy</span>
                  </div>
                  <h5 class="card-title fw-bold mb-2" style="color: #f1f5f9; font-size: 1.1rem; line-height: 1.4;">New AVS Pilot: Up to 6 Cats in HDB Flats</h5>
                  <p class="flex-grow-1" style="color: #94a3b8; font-size: 0.9rem; line-height: 1.6;">Starting August 3, 2026, approved cat fosterers can keep up to 6 cats in HDB flats and 10 in private homes under a new two-year pilot scheme.</p>
                  <div class="mt-3 pt-3 d-flex align-items-center justify-content-between" style="border-top: 1px solid #1e293b;">
                    <small class="fw-semibold" style="color: #64748b; font-size: 0.8rem;">📰 The Straits Times &nbsp;|&nbsp; July 2026</small>
                    <a href="https://www.straitstimes.com/singapore/cat-fosterers-to-be-allowed-up-to-six-cats-in-hdb-flats-under-new-pilot" class="btn btn-outline-teal btn-sm" target="_blank" rel="noopener noreferrer">Read Article ↗</a>
                  </div>
                </div>
              </div>
            </div>

            <!-- News Card 2 -->
            <div class="col-4">
              <div class="card h-100 shadow-sm rounded-4 border-0" style="border-top: 4px solid #2dd4bf !important; background: #0f172a;">
                <div class="card-body p-4 d-flex flex-column">
