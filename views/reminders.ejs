<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container">
    <div class="row mt-4">
        <div class="col-12">

            <div class="card shadow rounded-4 border-0">

                <div class="card-body p-5">

                    <h2 class="text-center fw-bold mb-4" style="color: var(--primary-teal);">
                        🔔 Care Reminders
                    </h2>

                    <% if (role === 'customer') { %>
                    <div class="d-flex justify-content-end mb-4">
                        <a href="/reminders/add"
                           class="btn btn-success rounded-pill fw-bold px-4">
                            ➕ Add Reminder
                        </a>
                    </div>
                    <% } %>

                    <% if (reminders.length === 0) { %>

                        <div class="alert alert-info text-center">
                            No reminders found.
                        </div>

                    <% } else { %>

                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead class="table-light">

                                <tr>

                                    <th>Pet</th>
                                    <th>Reminder</th>
                                    <th>Due Date</th>
                                    <th>Status</th>

                                    <% if (role === 'customer') { %>
                                        <th class="text-end">Actions</th>
                                    <% } %>

                                </tr>

                            </thead>

                            <tbody>

                                <% reminders.forEach(function(reminder){ %>

                                <tr>

                                    <td><strong><%= reminder.pet_name %></strong></td>

                                    <td><%= reminder.reminder_title %></td>

                                    <td>
                                        <%= new Date(reminder.due_date).toLocaleDateString() %>
                                    </td>

                                    <td>

                                        <% if(reminder.displayStatus==="Completed"){ %>

                                            <span class="badge bg-success">
                                                Completed
                                            </span>

                                        <% } else if(reminder.displayStatus==="Overdue"){ %>

                                            <span class="badge bg-danger">
                                                Overdue
                                            </span>

                                        <% } else if(reminder.displayStatus==="Due Today"){ %>

                                            <span class="badge bg-warning text-dark">
                                                Due Today
                                            </span>

                                        <% } else { %>

                                            <span class="badge bg-primary">
                                                Upcoming
                                            </span>

                                        <% } %>

                                    </td>

                                    <% if (role === 'customer') { %>

                                    <td class="text-end">

                                        <a href="/reminders/edit/<%= reminder.id %>"
                                           class="btn btn-warning btn-sm">
                                            ✏️ Edit
                                        </a>

                                        <form
                                            action="/reminders/delete/<%= reminder.id %>"
                                            method="POST"
                                            class="d-inline"
                                            onsubmit="return confirm('Delete this reminder?');">

                                            <button class="btn btn-danger btn-sm">
                                                🗑 Delete
                                            </button>

                                        </form>

                                    </td>

                                    <% } %>

                                </tr>

                                <% }) %>

                            </tbody>

                        </table>

                    </div>

                    <% } %>

                    <div class="text-center mt-4">

                        <% if (role === 'customer') { %>

                            <a href="/customer-dashboard"
                               class="btn btn-secondary rounded-pill px-4">
                                ← Back to Dashboard
                            </a>

                        <% } else { %>

                            <a href="/staff-dashboard"
                               class="btn btn-secondary rounded-pill px-4">
                                ← Back to Dashboard
                            </a>

                        <% } %>

                    </div>

                </div>

            </div>

        </div>
    </div>
</main>

</body>
</html>