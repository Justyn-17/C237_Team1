<%- include('partials/header') %>

<div class="app-shell">
  <%- include('partials/customer-sidebar', { activePage: 'dashboard' }) %>

  <main class="app-main">
    <%- include('partials/customer-topbar') %>

    <div class="app-content">

      <%
        const recordChip = t =>
          t === 'Vaccination' ? 'chip-green' :
          t === 'Medication'  ? 'chip-violet' :
          t === 'Feeding'     ? 'chip-amber'  : 'chip-blue';

        const countOf = t => records.filter(r => r.record_type === t).length;
      %>

      <div class="page-head">
        <div>
          <h1 class="page-title">🐾 <span class="accent"><%= pet.name %></span></h1>
          <p class="page-sub">Care history and health records.</p>
        </div>
        <div class="d-flex gap-2">
          <a href="/pets/edit/<%= pet.id %>" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-pencil me-1"></i> Edit
          </a>
          <a href="/customer-dashboard" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Dashboard
          </a>
        </div>
      </div>

      <div class="row g-3">

        <!-- Pet profile -->
        <div class="col-lg-4">
          <div class="panel mb-3">
            <div class="panel-body text-center">
              <img src="<%= photoPath(pet.photo) || petPlaceholder %>"
                   alt="<%= pet.name %>" class="rounded-4 shadow-sm mb-3"
                   style="width: 150px; height: 150px; object-fit: cover;">
              <h5 class="fw-bold mb-1 text-dark"><%= pet.name %></h5>
              <div class="text-muted small mb-3"><%= pet.breed || 'Unknown breed' %></div>

              <div class="d-flex flex-wrap justify-content-center gap-2">
                <span class="chip chip-teal"><%= pet.species %></span>
                <span class="chip"><%= pet.gender %></span>
                <span class="chip chip-violet"><%= pet.age %> yr</span>
              </div>
            </div>
          </div>

          <div class="panel">
            <div class="panel-head">
              <h6 class="panel-title">Record Summary</h6>
            </div>
            <div class="panel-body">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small">Feeding</span>
                <span class="chip chip-amber"><%= countOf('Feeding') %></span>
              </div>
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small">Vaccination</span>
                <span class="chip chip-green"><%= countOf('Vaccination') %></span>
              </div>
              <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small">Medication</span>
                <span class="chip chip-violet"><%= countOf('Medication') %></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Care records -->
        <div class="col-lg-8">
          <div class="panel mb-3">
            <div class="panel-head flex-wrap">
              <h6 class="panel-title">Care Records</h6>
              <!-- Filter by record type -->
              <div class="filter-pills">
                <a href="/pets/view/<%= pet.id %>"
                   class="filter-pill <%= !typeFilter ? 'active' : '' %>">All</a>
                <a href="/pets/view/<%= pet.id %>?type=Feeding"
                   class="filter-pill <%= typeFilter === 'Feeding' ? 'active' : '' %>">Feeding</a>
                <a href="/pets/view/<%= pet.id %>?type=Vaccination"
                   class="filter-pill <%= typeFilter === 'Vaccination' ? 'active' : '' %>">Vaccination</a>
                <a href="/pets/view/<%= pet.id %>?type=Medication"
                   class="filter-pill <%= typeFilter === 'Medication' ? 'active' : '' %>">Medication</a>
              </div>
            </div>

            <% if (records.length > 0) { %>
              <div class="table-responsive">
                <table class="app-table">
                  <thead>
                    <tr>
                      <th>Date</th>
                      <th>Type</th>
                      <th>Description</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% records.forEach(function(record) { %>
                      <tr>
                        <td class="text-nowrap">
                          <%= new Date(record.record_date).toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' }) %>
                        </td>
                        <td>
                          <span class="chip <%= recordChip(record.record_type) %>"><%= record.record_type %></span>
                        </td>
                        <td><%= record.description || '—' %></td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="empty-state">
                <span class="empty-emoji">📋</span>
                <h6><%= typeFilter ? `No ${typeFilter} records yet` : 'No care records yet' %></h6>
                <p>Add your first record below to start building <%= pet.name %>'s history.</p>
              </div>
            <% } %>
          </div>

          <div class="panel">
            <div class="panel-head">
              <h6 class="panel-title">Add Care Record</h6>
            </div>
            <div class="panel-body">
              <form action="/pets/<%= pet.id %>/care-records" method="POST" class="row g-2 align-items-end">
                <div class="col-md-3">
                  <label class="form-label-sm d-block">Type</label>
                  <select name="record_type" class="form-select app-input" required>
                    <option value="" disabled selected>Select</option>
                    <option value="Feeding">Feeding</option>
                    <option value="Vaccination">Vaccination</option>
                    <option value="Medication">Medication</option>
                  </select>
                </div>
                <div class="col-md-5">
                  <label class="form-label-sm d-block">Description</label>
                  <input type="text" name="description" maxlength="255"
                         class="form-control app-input" placeholder="e.g. Rabies booster">
                </div>
                <div class="col-md-2">
                  <label class="form-label-sm d-block">Date</label>
                  <input type="date" name="record_date" class="form-control app-input" required>
                </div>
                <div class="col-md-2">
                  <button type="submit" class="btn btn-primary w-100 rounded-pill fw-semibold">
                    <i class="bi bi-plus-lg"></i> Add
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>

      </div>

    </div>
  </main>
</div>

</body>
</html>
